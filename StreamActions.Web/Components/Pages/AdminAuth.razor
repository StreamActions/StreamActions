@page "/admin/auth"
@attribute [Authorize(Policy = AuthClaims.RootOrGlobalAdminPolicy)]
@rendermode InteractiveServer

@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using StreamActions.Core.Abstractions
@using StreamActions.Core.Models
@using StreamActions.Core.Models.Entities

@inject IInstanceSettingsService InstanceSettingsService
@inject IInstanceOAuthConfigService InstanceOAuthConfigService
@inject IExternalOidcProviderStore OidcProviderStore
@inject IEnumerable<IPlatformOAuthProvider> PlatformProviders
@inject IServiceProvider ServiceProvider

<PageTitle>@AuthPolicyParser.FormatPageTitle("Authentication Administration", _pageInstanceName)</PageTitle>

<h1>Authentication Administration</h1>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <p role="status" data-admin-auth-status="true">@_statusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p role="alert" data-admin-auth-error="true">@_errorMessage</p>
}

<StepUpMfaGuard OperationDescription="Confirm MFA verification to modify instance authentication policies, OAuth credentials, or external OIDC providers.">
<section aria-labelledby="auth-policies-heading">
    <h2 id="auth-policies-heading">Instance Authentication Policies</h2>
    <div>
        <label for="instance-name">Instance Name</label>
        <input id="instance-name" type="text" @bind="_instanceName" autocomplete="off" />
    </div>
    <div>
        <label for="totp-issuer-name">TOTP Issuer Name</label>
        <input id="totp-issuer-name" type="text" @bind="_totpIssuerName" autocomplete="off" />
    </div>
    <div>
        <label for="oauth-app-policy">Instance OAuth App Policy</label>
        <select id="oauth-app-policy" @bind="_oauthAppPolicy">
            <option value="@InstanceOAuthAppPolicy.InstanceOnly">Instance Only</option>
            <option value="@InstanceOAuthAppPolicy.InstanceWithOptionalOverride">Instance With Optional Override</option>
            <option value="@InstanceOAuthAppPolicy.InstanceLoginWithStreamerApiOAuth">Instance Login With Streamer API OAuth</option>
            <option value="@InstanceOAuthAppPolicy.RequireStreamerOAuthApp">Require Streamer OAuth App</option>
        </select>
    </div>
    <fieldset>
        <legend>Per-Platform OAuth App Policy Overrides</legend>
        @foreach (string platformId in _availablePlatforms)
        {
            <div>
                <label for="platform-oauth-policy-@platformId">@platformId</label>
                <select id="platform-oauth-policy-@platformId"
                        value="@GetPlatformOAuthPolicyOverrideValue(platformId)"
                        @onchange="(ChangeEventArgs args) => SetPlatformOAuthPolicyOverride(platformId, args.Value?.ToString())">
                    <option value="">Use Instance Default</option>
                    <option value="@InstanceOAuthAppPolicy.InstanceOnly">Instance Only</option>
                    <option value="@InstanceOAuthAppPolicy.InstanceWithOptionalOverride">Instance With Optional Override</option>
                    <option value="@InstanceOAuthAppPolicy.InstanceLoginWithStreamerApiOAuth">Instance Login With Streamer API OAuth</option>
                    <option value="@InstanceOAuthAppPolicy.RequireStreamerOAuthApp">Require Streamer OAuth App</option>
                </select>
            </div>
        }
    </fieldset>
    <div>
        <label for="bot-account-policy">Instance Bot Account Policy</label>
        <select id="bot-account-policy" @bind="_botAccountPolicy">
            <option value="@InstanceBotAccountPolicy.DefaultOnly">Default Only</option>
            <option value="@InstanceBotAccountPolicy.DefaultWithOptionalOverride">Default With Optional Override</option>
            <option value="@InstanceBotAccountPolicy.RequireStreamerBotAccount">Require Streamer Bot Account</option>
        </select>
    </div>
    <div>
        <label for="oidc-login-mode">External OIDC Login Mode</label>
        <select id="oidc-login-mode" @bind="_oidcLoginMode">
            <option value="@ExternalOidcLoginMode.Allowed">Allowed</option>
            <option value="@ExternalOidcLoginMode.Disabled">Disabled</option>
            <option value="@ExternalOidcLoginMode.Required">Required</option>
        </select>
    </div>
    <div>
        <label for="allow-open-registration">
            <input id="allow-open-registration" type="checkbox" @bind="_allowOpenRegistration" />
            Allow Open Self-Registration
        </label>
    </div>
    <div>
        <label for="mfa-passkey-availability">Passkey (WebAuthn) Availability</label>
        <select id="mfa-passkey-availability" @bind="_mfaPasskeyAvailability">
            <option value="@MfaMethodAvailability.Allowed">Allowed</option>
            <option value="@MfaMethodAvailability.Disabled">Disabled</option>
            <option value="@MfaMethodAvailability.Required">Required</option>
        </select>
    </div>
    <div>
        <label for="mfa-totp-availability">Authenticator App (TOTP) Availability</label>
        <select id="mfa-totp-availability" @bind="_mfaTotpAvailability">
            <option value="@MfaMethodAvailability.Allowed">Allowed</option>
            <option value="@MfaMethodAvailability.Disabled">Disabled</option>
            <option value="@MfaMethodAvailability.Required">Required</option>
        </select>
    </div>
    <div>
        <label for="login-mfa-requirement">Panel Login MFA Requirement</label>
        <select id="login-mfa-requirement" @bind="_loginMfaRequirement">
            <option value="@PanelLoginMfaRequirement.Optional">Optional</option>
            <option value="@PanelLoginMfaRequirement.RequiredForRootAndStreamers">Required for Root &amp; Streamers</option>
            <option value="@PanelLoginMfaRequirement.RequiredForModerators">Required for Moderators</option>
            <option value="@PanelLoginMfaRequirement.RequiredForAll">Required for All Users</option>
        </select>
    </div>
    <div>
        <label for="step-up-sudo-policy">Step-Up MFA Policy (Sudo Mode)</label>
        <select id="step-up-sudo-policy" @bind="_stepUpSudoPolicy">
            <option value="@StepUpSudoPolicy.Optional">Optional</option>
            <option value="@StepUpSudoPolicy.Required">Required</option>
        </select>
    </div>
    <button type="button" @onclick="SavePoliciesAsync">Save Policies</button>
</section>

<section aria-labelledby="platform-oauth-heading">
    <h2 id="platform-oauth-heading">Platform OAuth Application</h2>
    <div>
        <label for="platform-oauth-select">Platform</label>
        <select id="platform-oauth-select" @bind="_selectedPlatformId" @bind:after="LoadSelectedPlatformOAuthAsync">
            @foreach (string platformId in _availablePlatforms)
            {
                <option value="@platformId">@platformId</option>
            }
        </select>
    </div>
    <p data-platform-oauth-mode="true">
        @if (_hasExistingPlatformSecret)
        {
            <span>Mode: <strong>Confidential</strong> (client secret stored + PKCE)</span>
        }
        else if (_hasExistingPlatformConfig)
        {
            <span>Mode: <strong>Public PKCE</strong> (no client secret stored)</span>
        }
        else
        {
            <span>Mode: <strong>Not configured</strong> (leave Client Secret blank for a Public PKCE client)</span>
        }
    </p>
    <div>
        <label for="platform-client-id">Client ID</label>
        <input id="platform-client-id" type="text" @bind="_platformClientId" autocomplete="off" />
    </div>
    <div>
        <label for="platform-client-secret">
            Client Secret (@(_hasExistingPlatformSecret ? "configured; leave blank to keep existing" : "optional for Public PKCE clients; write-only"))
        </label>
        <input id="platform-client-secret"
               type="password"
               @bind="_platformClientSecret"
               placeholder="@(_hasExistingPlatformSecret ? "Leave blank to keep existing secret" : "Optional for Public PKCE clients")"
               autocomplete="new-password" />
    </div>
    @if (_hasExistingPlatformSecret)
    {
        <div>
            <label for="platform-clear-client-secret">
                <input id="platform-clear-client-secret" type="checkbox" @bind="_clearPlatformClientSecret" />
                Clear stored client secret (switch to Public PKCE client)
            </label>
        </div>
    }
    <div>
        <button type="button" @onclick="SavePlatformOAuthAsync">Save Platform OAuth</button>
        <button type="button" @onclick="ClearPlatformOAuthAsync">Remove Platform OAuth</button>
        <a href="/auth/@_selectedPlatformId/login?flow=instance-bot">Connect Instance Bot Account</a>
    </div>
</section>

<section aria-labelledby="oidc-providers-heading">
    <h2 id="oidc-providers-heading">External OIDC Providers</h2>

    @if (_oidcProviders.Count == 0)
    {
        <p>No instance external OIDC providers configured.</p>
    }
    else
    {
        <ul>
            @foreach (ExternalOidcProvider provider in _oidcProviders)
            {
                <li>
                    <strong>@provider.DisplayName</strong> (<code>@provider.Slug</code>) — @provider.AuthorityUrl
                    <span>[@(provider.IsEnabled ? "Enabled" : "Disabled")]</span>
                    <button type="button" @onclick="() => BeginEditOidcProvider(provider)">Edit</button>
                    <button type="button" @onclick="() => DeleteOidcProviderAsync(provider.Id)">Delete</button>
                </li>
            }
        </ul>
    }

    <h3>@(_editingOidcProviderId is null ? "Add External OIDC Provider" : "Edit External OIDC Provider")</h3>
    <div>
        <label for="oidc-slug">Slug</label>
        <input id="oidc-slug" type="text" @bind="_oidcSlug" autocomplete="off" />
    </div>
    <div>
        <label for="oidc-display-name">Display Name</label>
        <input id="oidc-display-name" type="text" @bind="_oidcDisplayName" autocomplete="off" />
    </div>
    <div>
        <label for="oidc-authority-url">Authority URL</label>
        <input id="oidc-authority-url" type="url" @bind="_oidcAuthorityUrl" autocomplete="off" />
    </div>
    <div>
        <label for="oidc-client-id">Client ID</label>
        <input id="oidc-client-id" type="text" @bind="_oidcClientId" autocomplete="off" />
    </div>
    <div>
        <label for="oidc-client-secret">
            Client Secret (@(_editingOidcProviderId is not null ? "leave blank to preserve existing" : "required"))
        </label>
        <input id="oidc-client-secret" type="password" @bind="_oidcClientSecret" autocomplete="new-password" />
    </div>
    <div>
        <label for="oidc-scopes">Scopes (comma-separated)</label>
        <input id="oidc-scopes" type="text" @bind="_oidcScopesInput" autocomplete="off" />
    </div>
    <div>
        <label for="oidc-group-claim">Group Claim Type</label>
        <input id="oidc-group-claim" type="text" @bind="_oidcGroupClaimType" autocomplete="off" />
    </div>
    <div>
        <label for="oidc-enabled">
            <input id="oidc-enabled" type="checkbox" @bind="_oidcIsEnabled" />
            Enabled
        </label>
    </div>
    <div>
        <button type="button" @onclick="SaveOidcProviderAsync">Save OIDC Provider</button>
        <button type="button" @onclick="ResetOidcForm">Reset Form</button>
    </div>
</section>

@if (_hasUserManagementStores)
{
    <section aria-labelledby="panel-users-mfa-heading" data-admin-users-mfa="true">
        <h2 id="panel-users-mfa-heading">Panel Users &amp; MFA Management</h2>
        <DataTableGrid TItem="PanelUserMfaEntry"
                       GridId="admin-panel-users-grid"
                       Items="@_panelUserMfaEntries"
                       FilterPredicate="MatchesPanelUserSearch"
                       SearchPlaceholder="Filter users by display name or role...">
            <EmptyContent>
                <p>No panel users found.</p>
            </EmptyContent>
            <HeaderContent>
                <tr>
                    <th>User</th>
                    <th>Roles</th>
                    <th>MFA Status</th>
                    <th>Actions</th>
                </tr>
            </HeaderContent>
            <RowTemplate Context="entry">
                <tr @key="entry.User.Id" data-admin-user-row="@entry.User.Id.ToString("D")">
                    <td>@entry.User.DisplayName</td>
                    <td>@FormatUserRoles(entry.User)</td>
                    <td>@(entry.CredentialCount > 0 ? $"Enrolled ({entry.CredentialCount})" : "Not Enrolled")</td>
                    <td>
                        @if (entry.CredentialCount > 0 && (!entry.User.IsRoot || _currentUserIsRoot))
                        {
                            <button type="button"
                                    data-admin-reset-mfa="@entry.User.Id.ToString("D")"
                                    @onclick="() => RemoveUserMfaAsync(entry.User.Id)">
                                Remove MFA
                            </button>
                        }
                        @if (!entry.User.IsRoot || _currentUserIsRoot)
                        {
                            <button type="button"
                                    data-admin-force-logout="@entry.User.Id.ToString("D")"
                                    @onclick="() => ForceLogoutAllSessionsAsync(entry.User.Id)">
                                Force Logout All Sessions
                            </button>
                        }
                    </td>
                </tr>
            </RowTemplate>
        </DataTableGrid>
    </section>
}
</StepUpMfaGuard>

@code {
    /// <summary>
    /// Available platform identifiers.
    /// </summary>
    private List<string> _availablePlatforms = ["twitch"];

    /// <summary>
    /// Selected platform identifier for OAuth app editing.
    /// </summary>
    private string _selectedPlatformId = "twitch";

    /// <summary>
    /// Instance display name rendered in the page title.
    /// </summary>
    private string _pageInstanceName = AuthPolicyParser.DefaultInstanceName;

    /// <summary>
    /// Operator-configured instance display name input.
    /// </summary>
    private string _instanceName = AuthPolicyParser.DefaultInstanceName;

    /// <summary>
    /// Operator-configured TOTP authenticator issuer label input.
    /// </summary>
    private string _totpIssuerName = AuthPolicyParser.DefaultInstanceName;

    /// <summary>
    /// Per-platform OAuth app policy overrides (<see langword="null"/> means inherit the instance default).
    /// </summary>
    private readonly Dictionary<string, InstanceOAuthAppPolicy?> _platformOAuthPolicyOverrides = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Current instance OAuth app policy selection.
    /// </summary>
    private InstanceOAuthAppPolicy _oauthAppPolicy = InstanceOAuthAppPolicy.InstanceOnly;

    /// <summary>
    /// Current instance bot account policy selection.
    /// </summary>
    private InstanceBotAccountPolicy _botAccountPolicy = InstanceBotAccountPolicy.DefaultOnly;

    /// <summary>
    /// Current external OIDC login mode selection.
    /// </summary>
    private ExternalOidcLoginMode _oidcLoginMode = ExternalOidcLoginMode.Allowed;

    /// <summary>
    /// Whether open registration is permitted.
    /// </summary>
    private bool _allowOpenRegistration;

    /// <summary>
    /// Current instance-wide WebAuthn passkey availability policy selection.
    /// </summary>
    private MfaMethodAvailability _mfaPasskeyAvailability = MfaMethodAvailability.Allowed;

    /// <summary>
    /// Current instance-wide TOTP authenticator availability policy selection.
    /// </summary>
    private MfaMethodAvailability _mfaTotpAvailability = MfaMethodAvailability.Allowed;

    /// <summary>
    /// Current instance-wide panel login MFA requirement selection.
    /// </summary>
    private PanelLoginMfaRequirement _loginMfaRequirement = PanelLoginMfaRequirement.Optional;

    /// <summary>
    /// Current instance-wide step-up ("Sudo Mode") MFA policy selection.
    /// </summary>
    private StepUpSudoPolicy _stepUpSudoPolicy = StepUpSudoPolicy.Required;

    /// <summary>
    /// Platform OAuth client identifier input.
    /// </summary>
    private string _platformClientId = string.Empty;

    /// <summary>
    /// Write-only platform OAuth client secret input. Never populated from stored secrets.
    /// </summary>
    private string _platformClientSecret = string.Empty;

    /// <summary>
    /// Indicates whether the selected platform already has stored OAuth application credentials.
    /// </summary>
    private bool _hasExistingPlatformConfig;

    /// <summary>
    /// Indicates whether the selected platform currently has a stored client secret.
    /// </summary>
    private bool _hasExistingPlatformSecret;

    /// <summary>
    /// Indicates whether the administrator opted to clear the stored client secret on save and switch to a Public PKCE client.
    /// </summary>
    private bool _clearPlatformClientSecret;

    /// <summary>
    /// Configured instance-wide external OIDC providers.
    /// </summary>
    private IReadOnlyList<ExternalOidcProvider> _oidcProviders = [];

    /// <summary>
    /// Identifier of the OIDC provider currently being edited, or <see langword="null"/> when creating a new provider.
    /// </summary>
    private Guid? _editingOidcProviderId;

    /// <summary>
    /// OIDC provider slug input.
    /// </summary>
    private string _oidcSlug = string.Empty;

    /// <summary>
    /// OIDC provider display name input.
    /// </summary>
    private string _oidcDisplayName = string.Empty;

    /// <summary>
    /// OIDC provider authority URL input.
    /// </summary>
    private string _oidcAuthorityUrl = string.Empty;

    /// <summary>
    /// OIDC provider client identifier input.
    /// </summary>
    private string _oidcClientId = string.Empty;

    /// <summary>
    /// Write-only OIDC client secret input. Never populated from stored secrets.
    /// </summary>
    private string _oidcClientSecret = string.Empty;

    /// <summary>
    /// Comma-separated OIDC scopes input.
    /// </summary>
    private string _oidcScopesInput = "openid, profile, email";

    /// <summary>
    /// Optional OIDC group claim type input.
    /// </summary>
    private string _oidcGroupClaimType = "groups";

    /// <summary>
    /// Whether the OIDC provider being edited is enabled.
    /// </summary>
    private bool _oidcIsEnabled = true;

    /// <summary>
    /// Status banner message.
    /// </summary>
    private string? _statusMessage;

    /// <summary>
    /// Error banner message.
    /// </summary>
    private string? _errorMessage;

    /// <summary>
    /// Indicates whether <see cref="IPanelUserStore"/> and <see cref="IMfaCredentialStore"/> are registered.
    /// </summary>
    private bool _hasUserManagementStores;

    /// <summary>
    /// Indicates whether the current signed-in operator holds root privileges.
    /// </summary>
    private bool _currentUserIsRoot;

    /// <summary>
    /// Indicates whether the current signed-in operator holds global administrator privileges.
    /// </summary>
    private bool _currentUserIsGlobalAdmin;

    /// <summary>
    /// Loaded panel users paired with their enrolled MFA credential counts.
    /// </summary>
    private List<PanelUserMfaEntry> _panelUserMfaEntries = [];

    /// <summary>
    /// Loads current instance authentication policies, platform OAuth metadata, and OIDC providers.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous initialization operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        List<string> discoveredPlatforms = [.. PlatformProviders
            .Select(static p => p.PlatformId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(static p => p, StringComparer.OrdinalIgnoreCase)];
        if (discoveredPlatforms.Count > 0)
        {
            _availablePlatforms = discoveredPlatforms;
            _selectedPlatformId = discoveredPlatforms[0];
        }

        InstanceSettings settings = await InstanceSettingsService.GetAsync();
        _instanceName = AuthPolicyParser.ResolveInstanceName(settings);
        _pageInstanceName = _instanceName;
        _totpIssuerName = AuthPolicyParser.ResolveTotpIssuerName(settings);
        _oauthAppPolicy = AuthPolicyParser.ParseOAuthAppPolicy(settings.InstanceOAuthAppPolicy);
        _platformOAuthPolicyOverrides.Clear();
        foreach (string platformId in _availablePlatforms)
        {
            _platformOAuthPolicyOverrides[platformId] = AuthPolicyParser.TryGetPlatformOAuthAppPolicyOverride(
                settings,
                platformId,
                out InstanceOAuthAppPolicy overridePolicy)
                ? overridePolicy
                : null;
        }

        _botAccountPolicy = AuthPolicyParser.ParseBotAccountPolicy(settings.InstanceBotAccountPolicy);
        _oidcLoginMode = settings.ExternalOidcLoginMode;
        _allowOpenRegistration = settings.AllowOpenRegistration;
        _mfaPasskeyAvailability = settings.MfaPasskeyAvailability;
        _mfaTotpAvailability = settings.MfaTotpAvailability;
        _loginMfaRequirement = settings.LoginMfaRequirement;
        _stepUpSudoPolicy = settings.StepUpSudoPolicy;

        await LoadSelectedPlatformOAuthAsync();
        await ReloadOidcProvidersAsync();
        await ReloadPanelUsersMfaAsync();
    }

    /// <summary>
    /// Persists updated authentication policy flags into <see cref="InstanceSettings"/>.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous save operation.</returns>
    private async Task SavePoliciesAsync()
    {
        ClearMessages();
        InstanceSettings settings = await InstanceSettingsService.GetAsync();
        settings.InstanceName = string.IsNullOrWhiteSpace(_instanceName)
            ? AuthPolicyParser.DefaultInstanceName
            : _instanceName.Trim();
        settings.TotpIssuerName = string.IsNullOrWhiteSpace(_totpIssuerName)
            ? AuthPolicyParser.DefaultInstanceName
            : _totpIssuerName.Trim();
        settings.InstanceOAuthAppPolicy = _oauthAppPolicy.ToString();
        foreach (string platformId in _availablePlatforms)
        {
            InstanceOAuthAppPolicy? overridePolicy = _platformOAuthPolicyOverrides.GetValueOrDefault(platformId);
            AuthPolicyParser.SetPlatformOAuthAppPolicy(settings, platformId, overridePolicy);
        }

        settings.InstanceBotAccountPolicy = _botAccountPolicy.ToString();
        settings.ExternalOidcLoginMode = _oidcLoginMode;
        settings.AllowOpenRegistration = _allowOpenRegistration;
        settings.MfaPasskeyAvailability = _mfaPasskeyAvailability;
        settings.MfaTotpAvailability = _mfaTotpAvailability;
        settings.LoginMfaRequirement = _loginMfaRequirement;
        settings.StepUpSudoPolicy = _stepUpSudoPolicy;

        await InstanceSettingsService.UpdateAsync(settings);
        _instanceName = AuthPolicyParser.ResolveInstanceName(settings);
        _pageInstanceName = _instanceName;
        _totpIssuerName = AuthPolicyParser.ResolveTotpIssuerName(settings);
        _statusMessage = "Authentication policies updated.";
    }

    /// <summary>
    /// Gets the current select-option value for a platform's OAuth app policy override.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns>The enum name string when overridden, or an empty string for <c>Use Instance Default</c>.</returns>
    private string GetPlatformOAuthPolicyOverrideValue(string platformId) =>
        _platformOAuthPolicyOverrides.TryGetValue(platformId, out InstanceOAuthAppPolicy? policy) && policy.HasValue
            ? policy.Value.ToString()
            : string.Empty;

    /// <summary>
    /// Updates the in-memory per-platform OAuth app policy override from a select change event.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <param name="rawValue">The selected option value.</param>
    private void SetPlatformOAuthPolicyOverride(string platformId, string? rawValue) =>
        _platformOAuthPolicyOverrides[platformId] = string.IsNullOrWhiteSpace(rawValue)
            ? null
            : AuthPolicyParser.ParseOAuthAppPolicy(rawValue);

    /// <summary>
    /// Loads client ID metadata for the selected platform while keeping the secret field write-only.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous load operation.</returns>
    private async Task LoadSelectedPlatformOAuthAsync()
    {
        PlatformOAuthAppCredentials? existing = await InstanceOAuthConfigService
            .GetAsync(_selectedPlatformId);

        _platformClientId = existing?.ClientId ?? string.Empty;
        _platformClientSecret = string.Empty;
        _hasExistingPlatformConfig = existing is not null;
        _hasExistingPlatformSecret = !string.IsNullOrWhiteSpace(existing?.ClientSecret);
        _clearPlatformClientSecret = false;
    }

    /// <summary>
    /// Saves instance-wide platform OAuth credentials (Confidential or Public PKCE) without exposing any previously saved secret.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous save operation.</returns>
    private async Task SavePlatformOAuthAsync()
    {
        ClearMessages();
        if (string.IsNullOrWhiteSpace(_platformClientId))
        {
            _errorMessage = "Platform Client ID is required.";
            return;
        }

        string? enteredSecret = string.IsNullOrWhiteSpace(_platformClientSecret)
            ? null
            : _platformClientSecret.Trim();

        string? secretToPersist = enteredSecret;
        if (secretToPersist is null && !_clearPlatformClientSecret)
        {
            PlatformOAuthAppCredentials? existing = await InstanceOAuthConfigService
                .GetAsync(_selectedPlatformId);
            secretToPersist = string.IsNullOrWhiteSpace(existing?.ClientSecret)
                ? null
                : existing.ClientSecret;
        }

        await InstanceOAuthConfigService
            .SetAsync(_selectedPlatformId, new PlatformOAuthAppCredentials(_platformClientId.Trim(), secretToPersist));

        _platformClientSecret = string.Empty;
        _clearPlatformClientSecret = false;
        _hasExistingPlatformConfig = true;
        _hasExistingPlatformSecret = !string.IsNullOrWhiteSpace(secretToPersist);
        _statusMessage = $"Saved OAuth application credentials for {_selectedPlatformId}.";
    }

    /// <summary>
    /// Clears instance-wide platform OAuth credentials for the selected platform.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous remove operation.</returns>
    private async Task ClearPlatformOAuthAsync()
    {
        ClearMessages();
        _ = await InstanceOAuthConfigService.RemoveAsync(_selectedPlatformId);
        _platformClientId = string.Empty;
        _platformClientSecret = string.Empty;
        _hasExistingPlatformConfig = false;
        _hasExistingPlatformSecret = false;
        _clearPlatformClientSecret = false;
        _statusMessage = $"Removed OAuth application credentials for {_selectedPlatformId}.";
    }

    /// <summary>
    /// Populates the OIDC editor form from an existing provider without exposing its client secret.
    /// </summary>
    /// <param name="provider">The provider to edit.</param>
    private void BeginEditOidcProvider(ExternalOidcProvider provider)
    {
        ClearMessages();
        _editingOidcProviderId = provider.Id;
        _oidcSlug = provider.Slug;
        _oidcDisplayName = provider.DisplayName;
        _oidcAuthorityUrl = provider.AuthorityUrl;
        _oidcClientId = provider.ClientId;
        _oidcClientSecret = string.Empty;
        _oidcGroupClaimType = provider.GroupClaimType ?? string.Empty;
        _oidcIsEnabled = provider.IsEnabled;

        try
        {
            string[]? parsedScopes = JsonSerializer.Deserialize<string[]>(provider.ScopesJson);
            _oidcScopesInput = parsedScopes is { Length: > 0 }
                ? string.Join(", ", parsedScopes)
                : "openid, profile, email";
        }
        catch (JsonException)
        {
            _oidcScopesInput = "openid, profile, email";
        }
    }

    /// <summary>
    /// Creates or updates an instance-wide <see cref="ExternalOidcProvider"/>.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous save operation.</returns>
    private async Task SaveOidcProviderAsync()
    {
        ClearMessages();

        if (string.IsNullOrWhiteSpace(_oidcSlug)
            || string.IsNullOrWhiteSpace(_oidcDisplayName)
            || string.IsNullOrWhiteSpace(_oidcAuthorityUrl)
            || string.IsNullOrWhiteSpace(_oidcClientId))
        {
            _errorMessage = "Slug, Display Name, Authority URL, and Client ID are required.";
            return;
        }

        string? plaintextSecret = string.IsNullOrWhiteSpace(_oidcClientSecret)
            ? null
            : _oidcClientSecret.Trim();

        if (_editingOidcProviderId is null && plaintextSecret is null)
        {
            _errorMessage = "Client Secret is required when creating a new OIDC provider.";
            return;
        }

        string[] scopes = [.. _oidcScopesInput
            .Split([',', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.Ordinal)];

        ExternalOidcProvider provider = new()
        {
            Id = _editingOidcProviderId ?? Guid.Empty,
            WorkspaceId = null,
            Slug = _oidcSlug.Trim(),
            DisplayName = _oidcDisplayName.Trim(),
            AuthorityUrl = _oidcAuthorityUrl.Trim(),
            ClientId = _oidcClientId.Trim(),
            ScopesJson = JsonSerializer.Serialize(scopes.Length > 0 ? scopes : ["openid", "profile", "email"]),
            GroupClaimType = string.IsNullOrWhiteSpace(_oidcGroupClaimType) ? null : _oidcGroupClaimType.Trim(),
            IsEnabled = _oidcIsEnabled,
        };

        _ = await OidcProviderStore.UpsertAsync(provider, plaintextSecret);
        await ReloadOidcProvidersAsync();
        ResetOidcForm();
        _statusMessage = $"Saved external OIDC provider '{provider.Slug}'.";
    }

    /// <summary>
    /// Deletes an instance-wide <see cref="ExternalOidcProvider"/>.
    /// </summary>
    /// <param name="providerId">The provider identifier.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous delete operation.</returns>
    private async Task DeleteOidcProviderAsync(Guid providerId)
    {
        ClearMessages();
        _ = await OidcProviderStore.DeleteAsync(providerId);
        if (_editingOidcProviderId == providerId)
        {
            ResetOidcForm();
        }

        await ReloadOidcProvidersAsync();
        _statusMessage = "Deleted external OIDC provider.";
    }

    /// <summary>
    /// Resets the OIDC provider editor back to creation mode.
    /// </summary>
    private void ResetOidcForm()
    {
        _editingOidcProviderId = null;
        _oidcSlug = string.Empty;
        _oidcDisplayName = string.Empty;
        _oidcAuthorityUrl = string.Empty;
        _oidcClientId = string.Empty;
        _oidcClientSecret = string.Empty;
        _oidcScopesInput = "openid, profile, email";
        _oidcGroupClaimType = "groups";
        _oidcIsEnabled = true;
    }

    /// <summary>
    /// Reloads the list of instance-wide external OIDC providers.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous load operation.</returns>
    private async Task ReloadOidcProvidersAsync() =>
        _oidcProviders = await OidcProviderStore
            .GetProvidersAsync(workspaceId: null, enabledOnly: false);

    /// <summary>
    /// Clears any visible status or error banners.
    /// </summary>
    private void ClearMessages()
    {
        _statusMessage = null;
        _errorMessage = null;
    }

    /// <summary>
    /// Loads panel users and their enrolled MFA credential counts when optional user and MFA stores are available.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous load operation.</returns>
    private async Task ReloadPanelUsersMfaAsync()
    {
        IPanelUserStore? panelUserStore = ServiceProvider.GetService<IPanelUserStore>();
        IMfaCredentialStore? mfaCredentialStore = ServiceProvider.GetService<IMfaCredentialStore>();
        if (panelUserStore is null || mfaCredentialStore is null)
        {
            _hasUserManagementStores = false;
            _panelUserMfaEntries = [];
            return;
        }

        _hasUserManagementStores = true;

        AuthenticationStateProvider? authStateProvider = ServiceProvider.GetService<AuthenticationStateProvider>();
        if (authStateProvider is not null)
        {
            AuthenticationState authState = await authStateProvider.GetAuthenticationStateAsync();
            ClaimsPrincipal principal = authState.User;
            _currentUserIsRoot = AuthClaims.HasTrueClaim(principal, AuthClaims.IsRootClaimType);
            _currentUserIsGlobalAdmin = AuthClaims.HasTrueClaim(principal, AuthClaims.IsGlobalAdminClaimType);

            Guid? currentUserId = AuthClaims.GetPanelUserId(principal);
            if (currentUserId.HasValue)
            {
                PanelUser? currentUser = await panelUserStore.GetByIdAsync(currentUserId.Value);
                if (currentUser is not null)
                {
                    _currentUserIsRoot = _currentUserIsRoot || currentUser.IsRoot;
                    _currentUserIsGlobalAdmin = _currentUserIsGlobalAdmin || currentUser.IsGlobalAdmin;
                }
            }
        }

        IReadOnlyList<PanelUser> users = await panelUserStore.GetAllUsersAsync();
        List<PanelUserMfaEntry> entries = new(users.Count);
        foreach (PanelUser user in users)
        {
            IReadOnlyList<MfaCredentialSummary> summaries = await mfaCredentialStore
                .GetSummariesAsync(user.Id);
            entries.Add(new PanelUserMfaEntry(user, summaries.Count));
        }

        _panelUserMfaEntries = entries;
    }

    /// <summary>
    /// Removes all enrolled MFA credentials for the specified user and marks <see cref="PanelUser.MfaResetByAdminNoticePending"/>.
    /// </summary>
    /// <param name="targetUserId">The target panel user identifier.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous removal operation.</returns>
    private async Task RemoveUserMfaAsync(Guid targetUserId)
    {
        ClearMessages();
        IPanelUserStore? panelUserStore = ServiceProvider.GetService<IPanelUserStore>();
        IMfaCredentialStore? mfaCredentialStore = ServiceProvider.GetService<IMfaCredentialStore>();
        if (panelUserStore is null || mfaCredentialStore is null)
        {
            return;
        }

        if (!_currentUserIsRoot && !_currentUserIsGlobalAdmin)
        {
            _errorMessage = "Administrator privileges are required to remove MFA credentials.";
            return;
        }

        PanelUser? targetUser = await panelUserStore.GetByIdAsync(targetUserId);
        if (targetUser is null)
        {
            _errorMessage = "Target panel user was not found.";
            return;
        }

        if (targetUser.IsRoot && !_currentUserIsRoot)
        {
            _errorMessage = "Only the root operator may remove MFA credentials for a root account.";
            return;
        }

        _ = await mfaCredentialStore.ClearAllForUserAsync(targetUser.Id);
        targetUser.MfaResetByAdminNoticePending = true;
        _ = await panelUserStore.UpdateUserAsync(targetUser);

        await ReloadPanelUsersMfaAsync();
        _statusMessage = $"Removed MFA credentials for {targetUser.DisplayName}.";
    }

    /// <summary>
    /// Revokes all active panel sessions for the specified user and broadcasts a live revocation event to terminate open Blazor circuits.
    /// </summary>
    /// <param name="targetUserId">The target panel user identifier.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous revocation operation.</returns>
    private async Task ForceLogoutAllSessionsAsync(Guid targetUserId)
    {
        ClearMessages();
        IPanelUserStore? panelUserStore = ServiceProvider.GetService<IPanelUserStore>();
        if (panelUserStore is null)
        {
            return;
        }

        if (!_currentUserIsRoot && !_currentUserIsGlobalAdmin)
        {
            _errorMessage = "Administrator privileges are required to force logout sessions.";
            return;
        }

        PanelUser? targetUser = await panelUserStore.GetByIdAsync(targetUserId);
        if (targetUser is null)
        {
            _errorMessage = "Target panel user was not found.";
            return;
        }

        if (targetUser.IsRoot && !_currentUserIsRoot)
        {
            _errorMessage = "Only the root operator may force logout sessions for a root account.";
            return;
        }

        IPanelSessionService? sessionService = ServiceProvider.GetService<IPanelSessionService>();
        if (sessionService is not null)
        {
            _ = await sessionService.RevokeAllSessionsForUserAsync(targetUser.Id);
        }

        _statusMessage = $"Forced logout of all sessions for {targetUser.DisplayName}.";
    }

    /// <summary>
    /// Evaluates whether a <see cref="PanelUserMfaEntry"/> matches the user table search query.
    /// </summary>
    /// <param name="entry">The panel user MFA entry.</param>
    /// <param name="query">The search query text.</param>
    /// <returns><see langword="true"/> if the user's display name or roles match <paramref name="query"/>; otherwise, <see langword="false"/>.</returns>
    private static bool MatchesPanelUserSearch(PanelUserMfaEntry entry, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        string trimmed = query.Trim();
        return entry.User.DisplayName.Contains(trimmed, StringComparison.OrdinalIgnoreCase)
            || FormatUserRoles(entry.User).Contains(trimmed, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Formats a human-readable role summary for a <see cref="PanelUser"/>.
    /// </summary>
    /// <param name="user">The panel user.</param>
    /// <returns>The role summary string.</returns>
    private static string FormatUserRoles(PanelUser user)
    {
        List<string> roles = [];
        if (user.IsRoot)
        {
            roles.Add("Root");
        }

        if (user.IsGlobalAdmin)
        {
            roles.Add("GlobalAdmin");
        }

        return roles.Count > 0 ? string.Join(", ", roles) : "User";
    }

    /// <summary>
    /// Pairs a <see cref="PanelUser"/> with its count of enrolled MFA credentials.
    /// </summary>
    /// <param name="User">The panel user.</param>
    /// <param name="CredentialCount">The number of enrolled MFA credentials.</param>
    private sealed record PanelUserMfaEntry(PanelUser User, int CredentialCount);
}
