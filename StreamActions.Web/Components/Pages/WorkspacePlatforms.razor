    private string GetClientSecretInput(string platformId) =>
        _customClientSecrets.TryGetValue(platformId, out string? value) ? value : string.Empty;

    /// <summary>
    /// Updates the write-only client secret input value for <paramref name="platformId"/>.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <param name="value">The new secret input value.</param>
    private void SetClientSecretInput(string platformId, string? value) =>
        _customClientSecrets[platformId] = value ?? string.Empty;

    /// <summary>
    /// Gets a value indicating whether clearing the stored custom client secret was requested for <paramref name="platformId"/>.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns><see langword="true"/> if clearing is requested; otherwise, <see langword="false"/>.</returns>
    private bool GetClearClientSecretInput(string platformId) =>
        _clearCustomClientSecrets.TryGetValue(platformId, out bool clear) && clear;

    /// <summary>
    /// Updates whether clearing the stored custom client secret is requested for <paramref name="platformId"/>.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <param name="value">The checkbox value.</param>
    private void SetClearClientSecretInput(string platformId, object? value) =>
        _clearCustomClientSecrets[platformId] = value is bool clear && clear;

    /// <summary>
    /// Builds the callback URI display string for custom OAuth app registration.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns>The full callback URI string.</returns>
    private string BuildCallbackUriDisplay(string platformId) =>
        $"{Navigation.BaseUri.TrimEnd('/')}/auth/{Uri.EscapeDataString(platformId)}/callback";

    /// <summary>
    /// Builds the broadcaster authorization URL.
    /// </summary>
    /// <param name="workspaceId">The workspace identifier.</param>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns>The relative authorization initiation URL.</returns>
    private static string BuildBroadcasterAuthorizeHref(Guid workspaceId, string platformId) =>
        $"/auth/{Uri.EscapeDataString(platformId)}/login?flow=broadcaster&workspaceId={workspaceId:D}&returnUrl=%2Fworkspace%2Fplatforms";

    /// <summary>
    /// Builds the incremental broadcaster permission upgrade URL with the union of granted and missing scopes.
    /// </summary>
    /// <param name="workspaceId">The workspace identifier.</param>
    /// <param name="platformId">The platform identifier.</param>
    /// <param name="upgradeScopesUnion">The deduplicated union of granted and missing scopes.</param>
    /// <returns>The relative authorization initiation URL.</returns>
    private static string BuildBroadcasterUpgradeHref(
        Guid workspaceId,
        string platformId,
        IReadOnlyList<string> upgradeScopesUnion)
    {
        string encodedScopes = Uri.EscapeDataString(string.Join(' ', upgradeScopesUnion));
        return $"/auth/{Uri.EscapeDataString(platformId)}/login?flow=broadcaster&workspaceId={workspaceId:D}&scopes={encodedScopes}&returnUrl=%2Fworkspace%2Fplatforms";
    }

    /// <summary>
    /// Builds the personal bot authorization URL enforcing <c>force_verify=true</c>.
    /// </summary>
    /// <param name="workspaceId">The workspace identifier.</param>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns>The relative authorization initiation URL.</returns>
    private static string BuildPersonalBotAuthorizeHref(Guid workspaceId, string platformId) =>
        $"/auth/{Uri.EscapeDataString(platformId)}/login?flow=bot&workspaceId={workspaceId:D}&force_verify=true&returnUrl=%2Fworkspace%2Fplatforms";

    /// <summary>
    /// Clears any displayed status or error messages.
    /// </summary>
    private void ClearMessages()
    {
        _statusMessage = null;
        _errorMessage = null;
    }

    /// <summary>
    /// View state for a single attached workspace platform card.
    /// </summary>
    /// <param name="Attachment">The persisted workspace platform attachment.</param>
    /// <param name="BroadcasterFound">Whether a broadcaster token record exists.</param>
    /// <param name="BroadcasterStatus">The broadcaster token lifecycle status.</param>
    /// <param name="BroadcasterUsername">The optional broadcaster platform username.</param>
    /// <param name="ScopeDrift">The broadcaster token scope drift report.</param>
    /// <param name="BotResolution">The resolved bot credential status.</param>
    private sealed record PlatformCardState(
        WorkspacePlatform Attachment,
        bool BroadcasterFound,
        CredentialStatus BroadcasterStatus,
        string? BroadcasterUsername,
        ScopeDriftReport ScopeDrift,
        BotCredentialResolutionResult BotResolution);
}
