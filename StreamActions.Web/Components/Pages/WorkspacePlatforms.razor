@page "/workspace/platforms"
@attribute [Authorize(Policy = AuthClaims.PanelAuthenticatedPolicy)]
@rendermode InteractiveServer
@implements IDisposable

@using StreamActions.Core.Abstractions
@using StreamActions.Core.Models
@using StreamActions.Core.Models.Entities
@using StreamActions.Core.Permissions

@inject IWorkspaceSessionContext WorkspaceSession
@inject IWorkspaceStore WorkspaceStore
@inject IPlatformCredentialStore PlatformCredentialStore
@inject IBotCredentialResolver BotCredentialResolver
@inject IScopeDriftDetector ScopeDriftDetector
@inject IInstanceSettingsService InstanceSettingsService
@inject IPanelUserStore PanelUserStore
@inject IPermissionService PermissionService
@inject IEnumerable<IPlatformOAuthProvider> PlatformProviders
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>@AuthPolicyParser.FormatPageTitle("Workspace Platforms", _instanceName)</PageTitle>

<h1>Workspace Platforms</h1>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <p role="status" data-platforms-status="true">@_statusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p role="alert" data-platforms-error="true">@_errorMessage</p>
}

@if (_activeWorkspace is null)
{
    <p>No accessible workspace is currently selected.</p>
}
else
{
    <section aria-labelledby="workspace-overview-heading">
        <h2 id="workspace-overview-heading">@_activeWorkspace.Workspace.Name</h2>
        <p>Primary Platform: <strong>@_activeWorkspace.Workspace.PrimaryPlatformId</strong></p>
        <p>Bot Account Policy: <strong>@_botPolicy</strong> | OAuth App Policy: <strong>@_oauthPolicy</strong></p>

        @if (_botPolicy != InstanceBotAccountPolicy.RequireStreamerBotAccount)
        {
            bool customBotBlocked = IsCustomBotOverrideBlockedByRoot();
            <div>
                <label for="allow-custom-bot-override">
                    <input id="allow-custom-bot-override"
                           type="checkbox"
                           disabled="@customBotBlocked"
                           checked="@(_activeWorkspace.Workspace.AllowCustomBotAccountOverride && !customBotBlocked)"
                           @onchange="ToggleCustomBotOverrideAsync" />
                    Allow custom bot account override for this workspace@(customBotBlocked ? " (blocked by root policy)" : string.Empty)
                </label>
            </div>
        }
    </section>

    <StepUpMfaGuard WorkspaceId="@_activeWorkspace.Workspace.Id"
                    OperationDescription="Confirm MFA verification to manage workspace MFA policies, custom OAuth credentials, or broadcaster and bot accounts.">
    <section aria-labelledby="workspace-mfa-policy-heading" data-workspace-mfa-policy="true">
        <h2 id="workspace-mfa-policy-heading">Workspace MFA Policies</h2>
        <p>Workspace policies can enforce stricter rules than instance defaults (strictest setting always wins).</p>
        <div>
            <label for="ws-mfa-passkey-availability">Passkey (WebAuthn) Availability</label>
            <select id="ws-mfa-passkey-availability" disabled="@IsPasskeyPolicyFixedByRoot()" @bind="_wsMfaPasskeyAvailability">
                <option value="@MfaMethodAvailability.Allowed" disabled="@IsPasskeyOptionBlocked(MfaMethodAvailability.Allowed)">@FormatOptionLabel("Allowed", IsPasskeyOptionBlocked(MfaMethodAvailability.Allowed))</option>
                <option value="@MfaMethodAvailability.Disabled" disabled="@IsPasskeyOptionBlocked(MfaMethodAvailability.Disabled)">@FormatOptionLabel("Disabled", IsPasskeyOptionBlocked(MfaMethodAvailability.Disabled))</option>
                <option value="@MfaMethodAvailability.Required" disabled="@IsPasskeyOptionBlocked(MfaMethodAvailability.Required)">@FormatOptionLabel("Required", IsPasskeyOptionBlocked(MfaMethodAvailability.Required))</option>
            </select>
            @if (IsPasskeyPolicyFixedByRoot())
            {
                <span data-blocked-by-root-policy="true">(blocked by root policy)</span>
            }
        </div>
        <div>
            <label for="ws-mfa-totp-availability">Authenticator App (TOTP) Availability</label>
            <select id="ws-mfa-totp-availability" disabled="@IsTotpPolicyFixedByRoot()" @bind="_wsMfaTotpAvailability">
                <option value="@MfaMethodAvailability.Allowed" disabled="@IsTotpOptionBlocked(MfaMethodAvailability.Allowed)">@FormatOptionLabel("Allowed", IsTotpOptionBlocked(MfaMethodAvailability.Allowed))</option>
                <option value="@MfaMethodAvailability.Disabled" disabled="@IsTotpOptionBlocked(MfaMethodAvailability.Disabled)">@FormatOptionLabel("Disabled", IsTotpOptionBlocked(MfaMethodAvailability.Disabled))</option>
                <option value="@MfaMethodAvailability.Required" disabled="@IsTotpOptionBlocked(MfaMethodAvailability.Required)">@FormatOptionLabel("Required", IsTotpOptionBlocked(MfaMethodAvailability.Required))</option>
            </select>
            @if (IsTotpPolicyFixedByRoot())
            {
                <span data-blocked-by-root-policy="true">(blocked by root policy)</span>
            }
        </div>
        <div>
            <label for="ws-login-mfa-requirement">Workspace Login MFA Requirement</label>
            <select id="ws-login-mfa-requirement" disabled="@IsLoginMfaPolicyFixedByRoot()" @bind="_wsLoginMfaRequirement">
                <option value="@PanelLoginMfaRequirement.Optional" disabled="@IsLoginMfaOptionBlocked(PanelLoginMfaRequirement.Optional)">@FormatOptionLabel("Optional", IsLoginMfaOptionBlocked(PanelLoginMfaRequirement.Optional))</option>
                <option value="@PanelLoginMfaRequirement.RequiredForRootAndStreamers" disabled="@IsLoginMfaOptionBlocked(PanelLoginMfaRequirement.RequiredForRootAndStreamers)">@FormatOptionLabel("Required for Streamers", IsLoginMfaOptionBlocked(PanelLoginMfaRequirement.RequiredForRootAndStreamers))</option>
                <option value="@PanelLoginMfaRequirement.RequiredForModerators" disabled="@IsLoginMfaOptionBlocked(PanelLoginMfaRequirement.RequiredForModerators)">@FormatOptionLabel("Required for Moderators", IsLoginMfaOptionBlocked(PanelLoginMfaRequirement.RequiredForModerators))</option>
                <option value="@PanelLoginMfaRequirement.RequiredForAll" disabled="@IsLoginMfaOptionBlocked(PanelLoginMfaRequirement.RequiredForAll)">@FormatOptionLabel("Required for All Users", IsLoginMfaOptionBlocked(PanelLoginMfaRequirement.RequiredForAll))</option>
            </select>
            @if (IsLoginMfaPolicyFixedByRoot())
            {
                <span data-blocked-by-root-policy="true">(blocked by root policy)</span>
            }
        </div>
        <div>
            <label for="ws-step-up-sudo-policy">Workspace Step-Up MFA Policy (Sudo Mode)</label>
            <select id="ws-step-up-sudo-policy" disabled="@IsStepUpPolicyFixedByRoot()" @bind="_wsStepUpSudoPolicy">
                <option value="@StepUpSudoPolicy.Optional" disabled="@IsStepUpOptionBlocked(StepUpSudoPolicy.Optional)">@FormatOptionLabel("Optional", IsStepUpOptionBlocked(StepUpSudoPolicy.Optional))</option>
                <option value="@StepUpSudoPolicy.Required" disabled="@IsStepUpOptionBlocked(StepUpSudoPolicy.Required)">@FormatOptionLabel("Required", IsStepUpOptionBlocked(StepUpSudoPolicy.Required))</option>
            </select>
            @if (IsStepUpPolicyFixedByRoot())
            {
                <span data-blocked-by-root-policy="true">(blocked by root policy)</span>
            }
        </div>
        @{
            bool externalOidcBlocked = IsExternalOidcBlockedByRoot();
        }
        <div>
            <label for="ws-require-external-oidc">
                <input id="ws-require-external-oidc"
                       type="checkbox"
                       disabled="@externalOidcBlocked"
                       @bind="_wsRequireExternalOidcLogin" />
                Require External OIDC login for non-admin workspace access@(externalOidcBlocked ? " (blocked by root policy)" : string.Empty)
            </label>
        </div>
        <button type="button" @onclick="SaveWorkspaceMfaPoliciesAsync">Save Workspace MFA Policies</button>
    </section>

    <section aria-labelledby="attached-platforms-heading">
        <h2 id="attached-platforms-heading">Attached Platforms</h2>
        @if (_platformStates.Count == 0)
        {
            <p>No platforms are currently attached to this workspace.</p>
        }
        else
        {
            @foreach (PlatformCardState card in _platformStates)
            {
                string platformId = card.Attachment.PlatformId;
                <article data-platform-card="@platformId">
                    <h3>@platformId (@card.Attachment.Role)</h3>
                    <p>Channel / Guild ID: <code>@card.Attachment.PlatformChannelId</code></p>

                    <div>
                        <label for="role-@platformId">Role</label>
                        <select id="role-@platformId"
                                value="@card.Attachment.Role"
                                @onchange="(ChangeEventArgs args) => UpdatePlatformRoleAsync(card.Attachment, args)">
                            <option value="@PlatformRole.Primary">Primary</option>
                            <option value="@PlatformRole.SimulcastPeer">SimulcastPeer</option>
                            <option value="@PlatformRole.Addon">Addon</option>
                        </select>
                        @if (card.Attachment.Role != PlatformRole.Primary)
                        {
                            <button type="button" @onclick="() => RemovePlatformAsync(platformId)">Remove Platform</button>
                        }
                    </div>

                    <div data-broadcaster-status="@platformId">
                        <h4>Broadcaster Account</h4>
                        @if (card.BroadcasterFound)
                        {
                            <p>
                                Status: <strong>@card.BroadcasterStatus</strong>
                                @if (!string.IsNullOrWhiteSpace(card.BroadcasterUsername))
                                {
                                    <span>(@card.BroadcasterUsername)</span>
                                }
                            </p>
                        }
                        else
                        {
                            <p>Status: <strong>Not Connected</strong></p>
                        }

                        @if (card.BroadcasterFound && card.BroadcasterStatus == CredentialStatus.Active && card.ScopeDrift.HasDrift)
                        {
                            <div role="alert" data-scope-drift-banner="@platformId">
                                <p>
                                    <strong>Missing Platform Scopes — Click to Upgrade Permissions</strong>
                                    (Missing: @string.Join(", ", card.ScopeDrift.MissingScopes))
                                </p>
                                <a href="@BuildBroadcasterUpgradeHref(_activeWorkspace.Workspace.Id, platformId, card.ScopeDrift.UpgradeScopesUnion)">
                                    Upgrade Permissions
                                </a>
                            </div>
                        }

                        <a href="@BuildBroadcasterAuthorizeHref(_activeWorkspace.Workspace.Id, platformId)">
                            Authorize Broadcaster Account
                        </a>
                    </div>

                    <div data-bot-status="@platformId">
                        <h4>Chat Bot Account</h4>
                        <p>
                            Resolved Status: <strong>@card.BotResolution.Status</strong>
                            (@card.BotResolution.Source)
                            @if (!string.IsNullOrWhiteSpace(card.BotResolution.Payload?.PlatformUsername))
                            {
                                <span>— @card.BotResolution.Payload.PlatformUsername</span>
                            }
                        </p>

                        @if (_botPolicy != InstanceBotAccountPolicy.DefaultOnly
                            && (_botPolicy == InstanceBotAccountPolicy.RequireStreamerBotAccount || card.BotResolution.IsCustomOverrideAllowed || _activeWorkspace.Workspace.AllowCustomBotAccountOverride))
                        {
                            <div>
                                <a href="@BuildPersonalBotAuthorizeHref(_activeWorkspace.Workspace.Id, platformId)"
                                   data-personal-bot-link="@platformId">
                                    Authorize Personal Bot Account
                                </a>
                            </div>
                            <div>
                                <label for="use-broadcaster-bot-@platformId">
                                    <input id="use-broadcaster-bot-@platformId"
                                           type="checkbox"
                                           checked="@card.Attachment.Metadata.UseBroadcasterAsBot"
                                           @onchange="(ChangeEventArgs args) => ToggleUseBroadcasterAsBotAsync(card.Attachment, args)" />
                                    Use Broadcaster as Bot
                                </label>
                            </div>
                        }
                    </div>

                    @{
                        bool customOAuthBlocked = IsCustomOAuthBlockedByRoot(platformId);
                        bool hasCustomClientId = !string.IsNullOrWhiteSpace(card.Attachment.CustomClientId);
                        bool hasCustomSecret = !string.IsNullOrWhiteSpace(card.Attachment.EncryptedCustomClientSecret);
                    }
                    <div data-custom-oauth="@platformId">
                        <h4>Custom OAuth Application</h4>
                        @if (customOAuthBlocked)
                        {
                            <p role="note" data-custom-oauth-blocked="@platformId">
                                Custom OAuth application credentials are disabled (blocked by root policy).
                            </p>
                        }
                        <p data-custom-oauth-mode="@platformId">
                            @if (hasCustomSecret)
                            {
                                <span>Mode: <strong>Confidential</strong> (client secret stored + PKCE)</span>
                            }
                            else if (hasCustomClientId)
                            {
                                <span>Mode: <strong>Public PKCE</strong> (no client secret stored)</span>
                            }
                            else
                            {
                                <span>Mode: <strong>Not configured</strong> (leave Client Secret blank for a Public PKCE client)</span>
                            }
                        </p>
                        <p>
                            Redirect / Callback URI:
                            <code data-callback-uri="@platformId">@BuildCallbackUriDisplay(platformId)</code>
                        </p>
                        <div>
                            <label for="custom-client-id-@platformId">Client ID</label>
                            <input id="custom-client-id-@platformId"
                                   type="text"
                                   disabled="@customOAuthBlocked"
                                   value="@GetClientIdInput(platformId)"
                                   @onchange="(ChangeEventArgs args) => SetClientIdInput(platformId, args.Value?.ToString())"
                                   autocomplete="off" />
                        </div>
                        <div>
                            <label for="custom-client-secret-@platformId">
                                Client Secret (@(hasCustomSecret ? "configured; leave blank to keep existing" : "optional for Public PKCE clients; write-only"))
                            </label>
                            <input id="custom-client-secret-@platformId"
                                   type="password"
                                   disabled="@customOAuthBlocked"
                                   value="@GetClientSecretInput(platformId)"
                                   placeholder="@(hasCustomSecret ? "Leave blank to keep existing secret" : "Optional for Public PKCE clients")"
                                   @onchange="(ChangeEventArgs args) => SetClientSecretInput(platformId, args.Value?.ToString())"
                                   autocomplete="new-password" />
                        </div>
                        @if (hasCustomSecret)
                        {
                            <div>
                                <label for="custom-clear-client-secret-@platformId">
                                    <input id="custom-clear-client-secret-@platformId"
                                           type="checkbox"
                                           disabled="@customOAuthBlocked"
                                           checked="@GetClearClientSecretInput(platformId)"
                                           @onchange="(ChangeEventArgs args) => SetClearClientSecretInput(platformId, args.Value)" />
                                    Clear stored client secret (switch to Public PKCE client)
                                </label>
                            </div>
                        }
                        <div>
                            <label for="custom-redirect-uri-@platformId">Custom Redirect URI (optional)</label>
                            <input id="custom-redirect-uri-@platformId"
                                   type="url"
                                   disabled="@customOAuthBlocked"
                                   value="@GetRedirectUriInput(platformId)"
                                   @onchange="(ChangeEventArgs args) => SetRedirectUriInput(platformId, args.Value?.ToString())"
                                   autocomplete="off" />
                        </div>
                        <button type="button" disabled="@customOAuthBlocked" @onclick="() => SaveCustomOAuthAsync(platformId)">Save Custom OAuth</button>
                        <button type="button" disabled="@customOAuthBlocked" @onclick="() => ClearCustomOAuthAsync(platformId)">Clear Custom OAuth</button>
                    </div>
                </article>
            }
        }
    </section>

    <section aria-labelledby="attach-platform-heading">
        <h2 id="attach-platform-heading">Attach Platform</h2>
        <div>
            <label for="new-platform-id">Platform</label>
            <select id="new-platform-id" @bind="_newPlatformId">
                @foreach (string availablePlatform in _availablePlatforms)
                {
                    <option value="@availablePlatform">@availablePlatform</option>
                }
            </select>
            <label for="new-platform-role">Role</label>
            <select id="new-platform-role" @bind="_newPlatformRole">
                <option value="@PlatformRole.Primary">Primary</option>
                <option value="@PlatformRole.SimulcastPeer">SimulcastPeer</option>
                <option value="@PlatformRole.Addon">Addon</option>
            </select>
            <label for="new-platform-channel">Channel / Guild ID</label>
            <input id="new-platform-channel" type="text" @bind="_newPlatformChannelId" autocomplete="off" />
            <button type="button" @onclick="AttachPlatformAsync">Attach Platform</button>
        </div>
    </section>
    </StepUpMfaGuard>
}

<section aria-labelledby="linked-accounts-heading">
    <h2 id="linked-accounts-heading">Linked Accounts</h2>
    @if (_linkedIdentities.Count == 0)
    {
        <p>No external login identities linked.</p>
    }
    else
    {
        <ul>
            @foreach (UserLoginIdentity identity in _linkedIdentities)
            {
                <li>
                    <strong>@identity.ProviderId</strong>: @identity.ProviderUsername (<code>@identity.ProviderUserId</code>)
                </li>
            }
        </ul>
    }

    <div>
        @foreach (string platformId in _availablePlatforms)
        {
            <a href="/auth/@Uri.EscapeDataString(platformId)/login?flow=link&returnUrl=%2Fworkspace%2Fplatforms">
                Link @platformId Account
            </a>
        }
    </div>
</section>

@code {
    /// <summary>
    /// Cached UI inputs for custom OAuth client IDs keyed by platform identifier.
    /// </summary>
    private readonly Dictionary<string, string> _customClientIds = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Write-only UI inputs for custom OAuth client secrets keyed by platform identifier. Never populated from stored values.
    /// </summary>
    private readonly Dictionary<string, string> _customClientSecrets = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Tracks whether the user requested clearing the stored custom client secret on save, keyed by platform identifier.
    /// </summary>
    private readonly Dictionary<string, bool> _clearCustomClientSecrets = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Cached UI inputs for custom OAuth redirect URIs keyed by platform identifier.
    /// </summary>
    private readonly Dictionary<string, string> _customRedirectUris = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Active workspace wrapper from <see cref="IWorkspaceSessionContext"/>.
    /// </summary>
    private AccessibleWorkspace? _activeWorkspace;

    /// <summary>
    /// Registered platform identifiers available for attachment and linking.
    /// </summary>
    private List<string> _availablePlatforms = ["twitch"];

    /// <summary>
    /// Loaded platform attachment states for the active workspace.
    /// </summary>
    private List<PlatformCardState> _platformStates = [];

    /// <summary>
    /// Linked external login identities for the current user.
    /// </summary>
    private IReadOnlyList<UserLoginIdentity> _linkedIdentities = [];

    /// <summary>
    /// Active instance bot account policy.
    /// </summary>
    private InstanceBotAccountPolicy _botPolicy = InstanceBotAccountPolicy.DefaultOnly;

    /// <summary>
    /// Active instance OAuth application policy default.
    /// </summary>
    private InstanceOAuthAppPolicy _oauthPolicy = InstanceOAuthAppPolicy.InstanceOnly;

    /// <summary>
    /// Loaded instance settings used for per-platform OAuth policy resolution and branding.
    /// </summary>
    private InstanceSettings? _settings;

    /// <summary>
    /// Operator-configured instance display name.
    /// </summary>
    private string _instanceName = AuthPolicyParser.DefaultInstanceName;

    /// <summary>
    /// Indicates whether <see cref="BuiltInPermissionKeys.FeatureCustomBotAccount"/> is allowed for the active workspace.
    /// </summary>
    private bool _customBotFeatureAllowed;

    /// <summary>
    /// Indicates whether <see cref="BuiltInPermissionKeys.FeatureCustomOAuthApp"/> is allowed for the active workspace.
    /// </summary>
    private bool _customOAuthFeatureAllowed;

    /// <summary>
    /// Platform identifier input for attaching a new platform.
    /// </summary>
    private string _newPlatformId = "twitch";

    /// <summary>
    /// Platform role selection for attaching a new platform.
    /// </summary>
    private PlatformRole _newPlatformRole = PlatformRole.SimulcastPeer;

    /// <summary>
    /// Channel or guild identifier input for attaching a new platform.
    /// </summary>
    private string _newPlatformChannelId = string.Empty;

    /// <summary>
    /// Status banner message.
    /// </summary>
    private string? _statusMessage;

    /// <summary>
    /// Error banner message.
    /// </summary>
    private string? _errorMessage;

    /// <summary>
    /// Workspace-level WebAuthn passkey availability policy selection.
    /// </summary>
    private MfaMethodAvailability _wsMfaPasskeyAvailability = MfaMethodAvailability.Allowed;

    /// <summary>
    /// Workspace-level TOTP authenticator availability policy selection.
    /// </summary>
    private MfaMethodAvailability _wsMfaTotpAvailability = MfaMethodAvailability.Allowed;

    /// <summary>
    /// Workspace-level panel login MFA requirement selection.
    /// </summary>
    private PanelLoginMfaRequirement _wsLoginMfaRequirement = PanelLoginMfaRequirement.Optional;

    /// <summary>
    /// Workspace-level step-up ("Sudo Mode") MFA policy selection.
    /// </summary>
    private StepUpSudoPolicy _wsStepUpSudoPolicy = StepUpSudoPolicy.Required;

    /// <summary>
    /// Workspace-level requirement for External OIDC authentication.
    /// </summary>
    private bool _wsRequireExternalOidcLogin;

    /// <summary>
    /// Initializes platform connections, bot status, scope drift diagnostics, and linked identities.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous initialization operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        List<string> discoveredPlatforms = [.. PlatformProviders
            .Select(static p => p.PlatformId)
            .Where(static p => !string.IsNullOrWhiteSpace(p))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(static p => p, StringComparer.OrdinalIgnoreCase)];

        if (discoveredPlatforms.Count > 0)
        {
            _availablePlatforms = discoveredPlatforms;
            _newPlatformId = discoveredPlatforms[0];
        }

        WorkspaceSession.WorkspaceChanged += OnWorkspaceChanged;
        await WorkspaceSession.InitializeAsync();
        await LoadDataAsync();
    }

    /// <summary>
    /// Releases component event subscriptions.
    /// </summary>
    public void Dispose() => WorkspaceSession.WorkspaceChanged -= OnWorkspaceChanged;

    /// <summary>
    /// Reloads workspace platform state when the active workspace changes.
    /// </summary>
    /// <param name="sender">The event sender.</param>
    /// <param name="args">The event arguments.</param>
    private void OnWorkspaceChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });

    /// <summary>
    /// Loads instance policies, workspace platforms, broadcaster scope drift, bot status, and linked accounts.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous load operation.</returns>
    private async Task LoadDataAsync()
    {
        AccessibleWorkspace? activeWorkspace = WorkspaceSession.ActiveWorkspace;

        InstanceSettings settings = await InstanceSettingsService.GetAsync();
        string instanceName = AuthPolicyParser.ResolveInstanceName(settings);
        InstanceBotAccountPolicy botPolicy = AuthPolicyParser.ParseBotAccountPolicy(settings.InstanceBotAccountPolicy);
        InstanceOAuthAppPolicy oauthPolicy = AuthPolicyParser.ParseOAuthAppPolicy(settings.InstanceOAuthAppPolicy);

        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        Guid? panelUserId = AuthClaims.GetPanelUserId(authState.User);
        IReadOnlyList<UserLoginIdentity> linkedIdentities = panelUserId.HasValue
            ? await PanelUserStore.GetLoginIdentitiesAsync(panelUserId.Value)
            : [];

        if (activeWorkspace is null)
        {
            _activeWorkspace = null;
            _settings = settings;
            _instanceName = instanceName;
            _botPolicy = botPolicy;
            _oauthPolicy = oauthPolicy;
            _linkedIdentities = linkedIdentities;
            _platformStates = [];
            _customBotFeatureAllowed = false;
            _customOAuthFeatureAllowed = false;
            return;
        }

        Guid workspaceId = activeWorkspace.Workspace.Id;
        PlatformUserIdentity workspaceActor = new(
            activeWorkspace.Workspace.PrimaryPlatformId,
            "__workspace__",
            "workspace",
            PlatformUserDesignations.Broadcaster);

        bool customBotFeatureAllowed = await PermissionService
            .IsAllowedAsync(workspaceId, workspaceActor, BuiltInPermissionKeys.FeatureCustomBotAccount);
        bool customOAuthFeatureAllowed = await PermissionService
            .IsAllowedAsync(workspaceId, workspaceActor, BuiltInPermissionKeys.FeatureCustomOAuthApp);

        IReadOnlyList<WorkspacePlatform> attachments = await WorkspaceStore
            .GetPlatformsAsync(workspaceId);

        List<PlatformCardState> platformStates = new(attachments.Count);
        Dictionary<string, string> customClientIds = new(StringComparer.OrdinalIgnoreCase);
        Dictionary<string, string> customRedirectUris = new(StringComparer.OrdinalIgnoreCase);

        foreach (WorkspacePlatform attachment in attachments)
        {
            customClientIds[attachment.PlatformId] = attachment.CustomClientId ?? string.Empty;
            customRedirectUris[attachment.PlatformId] = attachment.CustomRedirectUri ?? string.Empty;

            (bool broadcasterFound, CredentialStatus broadcasterStatus, PlatformTokenPayload? broadcasterPayload) =
                await PlatformCredentialStore
                    .TryGetTokenAsync(workspaceId, attachment.PlatformId, TokenRole.Broadcaster);

            ScopeDriftReport drift = ScopeDriftDetector.DetectDrift(attachment.PlatformId, broadcasterPayload);
            BotCredentialResolutionResult botResolution = await BotCredentialResolver
                .ResolveAsync(workspaceId, attachment.PlatformId);

            platformStates.Add(new PlatformCardState(
                attachment,
                broadcasterFound,
                broadcasterStatus,
                broadcasterPayload?.PlatformUsername,
                drift,
                botResolution));
        }

        _activeWorkspace = activeWorkspace;
        _settings = settings;
        _instanceName = instanceName;
        _botPolicy = botPolicy;
        _oauthPolicy = oauthPolicy;
        _linkedIdentities = linkedIdentities;
        _customBotFeatureAllowed = customBotFeatureAllowed;
        _customOAuthFeatureAllowed = customOAuthFeatureAllowed;

        _wsMfaPasskeyAvailability = IsPasskeyPolicyFixedByRoot()
            ? settings.MfaPasskeyAvailability
            : activeWorkspace.Workspace.MfaPasskeyAvailability;
        _wsMfaTotpAvailability = IsTotpPolicyFixedByRoot()
            ? settings.MfaTotpAvailability
            : activeWorkspace.Workspace.MfaTotpAvailability;
        PanelLoginMfaRequirement rootLoginMfa = settings.LoginMfaRequirement;
        _wsLoginMfaRequirement = (PanelLoginMfaRequirement)Math.Max((int)rootLoginMfa, (int)activeWorkspace.Workspace.LoginMfaRequirement);
        StepUpSudoPolicy rootStepUp = settings.StepUpSudoPolicy;
        _wsStepUpSudoPolicy = (StepUpSudoPolicy)Math.Max((int)rootStepUp, (int)activeWorkspace.Workspace.StepUpSudoPolicy);
        _wsRequireExternalOidcLogin = activeWorkspace.Workspace.RequireExternalOidcLogin;

        foreach (KeyValuePair<string, string> kvp in customClientIds)
        {
            _customClientIds[kvp.Key] = kvp.Value;
        }

        foreach (KeyValuePair<string, string> kvp in customRedirectUris)
        {
            _customRedirectUris[kvp.Key] = kvp.Value;
        }

        foreach (string platformId in customClientIds.Keys)
        {
            _ = _customClientSecrets.TryAdd(platformId, string.Empty);
            _ = _clearCustomClientSecrets.TryAdd(platformId, false);
        }

        _platformStates = platformStates;
    }

    /// <summary>
    /// Attaches a new platform to the active workspace.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous save operation.</returns>
    private async Task AttachPlatformAsync()
    {
        ClearMessages();
        if (_activeWorkspace is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPlatformId) || string.IsNullOrWhiteSpace(_newPlatformChannelId))
        {
            _errorMessage = "Platform and Channel / Guild ID are required.";
            return;
        }

        _ = await WorkspaceStore.UpsertPlatformAsync(new WorkspacePlatform
        {
            WorkspaceId = _activeWorkspace.Workspace.Id,
            PlatformId = _newPlatformId.Trim(),
            Role = _newPlatformRole,
            PlatformChannelId = _newPlatformChannelId.Trim(),
        });

        _newPlatformChannelId = string.Empty;
        await WorkspaceSession.RefreshAsync();
        await LoadDataAsync();
        _statusMessage = $"Attached platform '{_newPlatformId.Trim()}'.";
    }

    /// <summary>
    /// Updates the <see cref="PlatformRole"/> of an attached workspace platform.
    /// </summary>
    /// <param name="attachment">The platform attachment.</param>
    /// <param name="args">The change event arguments containing the selected role.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous update operation.</returns>
    private async Task UpdatePlatformRoleAsync(WorkspacePlatform attachment, ChangeEventArgs args)
    {
        ClearMessages();
        if (!Enum.TryParse(args.Value?.ToString(), out PlatformRole newRole))
        {
            return;
        }

        attachment.Role = newRole;
        _ = await WorkspaceStore.UpsertPlatformAsync(attachment);
        await WorkspaceSession.RefreshAsync();
        await LoadDataAsync();
        _statusMessage = $"Updated role for '{attachment.PlatformId}' to {newRole}.";
    }

    /// <summary>
    /// Removes a non-primary platform attachment from the active workspace.
    /// </summary>
    /// <param name="platformId">The platform identifier to remove.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous removal operation.</returns>
    private async Task RemovePlatformAsync(string platformId)
    {
        ClearMessages();
        if (_activeWorkspace is null)
        {
            return;
        }

        _ = await WorkspaceStore
            .RemovePlatformAsync(_activeWorkspace.Workspace.Id, platformId);

        await WorkspaceSession.RefreshAsync();
        await LoadDataAsync();
        _statusMessage = $"Removed platform '{platformId}'.";
    }

    /// <summary>
    /// Toggles <see cref="Workspace.AllowCustomBotAccountOverride"/> for the active workspace.
    /// </summary>
    /// <param name="args">The checkbox change event arguments.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous update operation.</returns>
    private async Task ToggleCustomBotOverrideAsync(ChangeEventArgs args)
    {
        ClearMessages();
        if (IsCustomBotOverrideBlockedByRoot())
        {
            _errorMessage = "Custom bot account override is blocked by root policy.";
            return;
        }

        if (_activeWorkspace is null || args.Value is not bool enabled)
        {
            return;
        }

        _activeWorkspace.Workspace.AllowCustomBotAccountOverride = enabled;
        _ = await WorkspaceStore.UpdateWorkspaceAsync(_activeWorkspace.Workspace);
        await WorkspaceSession.RefreshAsync();
        await LoadDataAsync();
        _statusMessage = enabled
            ? "Enabled custom bot account override for this workspace."
            : "Disabled custom bot account override for this workspace.";
    }

    /// <summary>
    /// Persists workspace-level MFA policy overrides into <see cref="Workspace"/>.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous save operation.</returns>
    private async Task SaveWorkspaceMfaPoliciesAsync()
    {
        ClearMessages();
        if (_activeWorkspace is null)
        {
            return;
        }

        if (!IsPasskeyPolicyFixedByRoot())
        {
            _activeWorkspace.Workspace.MfaPasskeyAvailability = _wsMfaPasskeyAvailability;
        }

        if (!IsTotpPolicyFixedByRoot())
        {
            _activeWorkspace.Workspace.MfaTotpAvailability = _wsMfaTotpAvailability;
        }

        if (!IsLoginMfaPolicyFixedByRoot() && !IsLoginMfaOptionBlocked(_wsLoginMfaRequirement))
        {
            _activeWorkspace.Workspace.LoginMfaRequirement = _wsLoginMfaRequirement;
        }

        if (!IsStepUpPolicyFixedByRoot() && !IsStepUpOptionBlocked(_wsStepUpSudoPolicy))
        {
            _activeWorkspace.Workspace.StepUpSudoPolicy = _wsStepUpSudoPolicy;
        }

        if (!IsExternalOidcBlockedByRoot())
        {
            _activeWorkspace.Workspace.RequireExternalOidcLogin = _wsRequireExternalOidcLogin;
        }

        _ = await WorkspaceStore.UpdateWorkspaceAsync(_activeWorkspace.Workspace);
        await WorkspaceSession.RefreshAsync();
        await LoadDataAsync();
        _statusMessage = "Workspace MFA policies updated.";
    }

    /// <summary>
    /// Toggles <see cref="StreamActions.Core.Models.Metadata.PlatformMetadata.UseBroadcasterAsBot"/> for an attached platform.
    /// </summary>
    /// <param name="attachment">The platform attachment.</param>
    /// <param name="args">The checkbox change event arguments.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous update operation.</returns>
    private async Task ToggleUseBroadcasterAsBotAsync(WorkspacePlatform attachment, ChangeEventArgs args)
    {
        ClearMessages();
        if (args.Value is not bool useBroadcaster)
        {
            return;
        }

        attachment.Metadata.UseBroadcasterAsBot = useBroadcaster;
        _ = await WorkspaceStore.UpsertPlatformAsync(attachment);
        await WorkspaceSession.RefreshAsync();
        await LoadDataAsync();
        _statusMessage = useBroadcaster
            ? $"Enabled broadcaster identity fallback for '{attachment.PlatformId}'."
            : $"Disabled broadcaster identity fallback for '{attachment.PlatformId}'.";
    }

    /// <summary>
    /// Persists custom OAuth application credentials for a workspace platform without exposing stored secrets.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous save operation.</returns>
    private async Task SaveCustomOAuthAsync(string platformId)
    {
        ClearMessages();
        if (_activeWorkspace is null)
        {
            return;
        }

        if (IsCustomOAuthBlockedByRoot(platformId))
        {
            _errorMessage = "Custom OAuth application configuration is blocked by root policy.";
            return;
        }

        string clientId = GetClientIdInput(platformId).Trim();
        string? clientSecret = GetClientSecretInput(platformId);
        bool clearClientSecret = GetClearClientSecretInput(platformId);
        string rawRedirectUri = GetRedirectUriInput(platformId).Trim();
        if (string.IsNullOrWhiteSpace(clientId))
        {
            _errorMessage = "Custom OAuth Client ID is required.";
            return;
        }

        Uri? redirectUri = null;
        if (!string.IsNullOrWhiteSpace(rawRedirectUri))
        {
            if (!Uri.TryCreate(rawRedirectUri, UriKind.Absolute, out Uri? parsedUri)
                || (parsedUri.Scheme != Uri.UriSchemeHttp && parsedUri.Scheme != Uri.UriSchemeHttps))
            {
                _errorMessage = "Custom Redirect URI must be a valid HTTP or HTTPS URL.";
                return;
            }

            redirectUri = parsedUri;
        }

        string? normalizedSecret = string.IsNullOrWhiteSpace(clientSecret) ? null : clientSecret.Trim();
        _ = await WorkspaceStore
            .SetCustomOAuthAppAsync(
                _activeWorkspace.Workspace.Id,
                platformId,
                clientId,
                normalizedSecret,
                redirectUri,
                clearClientSecret: normalizedSecret is null && clearClientSecret);

        _customClientSecrets[platformId] = string.Empty;
        _clearCustomClientSecrets[platformId] = false;
        await LoadDataAsync();
        _statusMessage = $"Saved custom OAuth credentials for '{platformId}'.";
    }

    /// <summary>
    /// Clears custom OAuth application credentials for a workspace platform.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous clear operation.</returns>
    private async Task ClearCustomOAuthAsync(string platformId)
    {
        ClearMessages();
        if (_activeWorkspace is null)
        {
            return;
        }

        if (IsCustomOAuthBlockedByRoot(platformId))
        {
            _errorMessage = "Custom OAuth application configuration is blocked by root policy.";
            return;
        }

        _ = await WorkspaceStore
            .SetCustomOAuthAppAsync(_activeWorkspace.Workspace.Id, platformId, null, null);

        _customClientIds[platformId] = string.Empty;
        _customClientSecrets[platformId] = string.Empty;
        _clearCustomClientSecrets[platformId] = false;
        _customRedirectUris[platformId] = string.Empty;
        await LoadDataAsync();
        _statusMessage = $"Cleared custom OAuth credentials for '{platformId}'.";
    }

    /// <summary>
    /// Gets the current client ID input value for <paramref name="platformId"/>.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns>The client ID string.</returns>
    private string GetClientIdInput(string platformId) =>
        _customClientIds.TryGetValue(platformId, out string? value) ? value : string.Empty;

    /// <summary>
    /// Gets the current custom redirect URI input value for <paramref name="platformId"/>.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns>The redirect URI string.</returns>
    private string GetRedirectUriInput(string platformId) =>
        _customRedirectUris.TryGetValue(platformId, out string? value) ? value : string.Empty;

    /// <summary>
    /// Updates the custom redirect URI input value for <paramref name="platformId"/>.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <param name="value">The new redirect URI input value.</param>
    private void SetRedirectUriInput(string platformId, string? value) =>
        _customRedirectUris[platformId] = value ?? string.Empty;

    /// <summary>
    /// Resolves the effective <see cref="InstanceOAuthAppPolicy"/> for a specific platform.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns>The effective <see cref="InstanceOAuthAppPolicy"/>.</returns>
    private InstanceOAuthAppPolicy GetEffectiveOAuthPolicy(string platformId) =>
        _settings is null
            ? _oauthPolicy
            : AuthPolicyParser.ResolveOAuthAppPolicy(_settings, platformId);

    /// <summary>
    /// Determines whether the root instance policy fixes passkey availability.
    /// </summary>
    /// <returns><see langword="true"/> if root policy enforces Disabled or Required; otherwise, <see langword="false"/>.</returns>
    private bool IsPasskeyPolicyFixedByRoot() =>
        (_settings?.MfaPasskeyAvailability ?? MfaMethodAvailability.Allowed) != MfaMethodAvailability.Allowed;

    /// <summary>
    /// Determines whether a passkey availability option is blocked by the root instance policy.
    /// </summary>
    /// <param name="option">The workspace option value.</param>
    /// <returns><see langword="true"/> if blocked by root policy; otherwise, <see langword="false"/>.</returns>
    private bool IsPasskeyOptionBlocked(MfaMethodAvailability option)
    {
        MfaMethodAvailability root = _settings?.MfaPasskeyAvailability ?? MfaMethodAvailability.Allowed;
        return root != MfaMethodAvailability.Allowed && option != root;
    }

    /// <summary>
    /// Determines whether the root instance policy fixes TOTP availability.
    /// </summary>
    /// <returns><see langword="true"/> if root policy enforces Disabled or Required; otherwise, <see langword="false"/>.</returns>
    private bool IsTotpPolicyFixedByRoot() =>
        (_settings?.MfaTotpAvailability ?? MfaMethodAvailability.Allowed) != MfaMethodAvailability.Allowed;

    /// <summary>
    /// Determines whether a TOTP availability option is blocked by the root instance policy.
    /// </summary>
    /// <param name="option">The workspace option value.</param>
    /// <returns><see langword="true"/> if blocked by root policy; otherwise, <see langword="false"/>.</returns>
    private bool IsTotpOptionBlocked(MfaMethodAvailability option)
    {
        MfaMethodAvailability root = _settings?.MfaTotpAvailability ?? MfaMethodAvailability.Allowed;
        return root != MfaMethodAvailability.Allowed && option != root;
    }

    /// <summary>
    /// Determines whether the root instance policy fixes the panel login MFA requirement to its strictest level.
    /// </summary>
    /// <returns><see langword="true"/> if root policy requires MFA for all users; otherwise, <see langword="false"/>.</returns>
    private bool IsLoginMfaPolicyFixedByRoot() =>
        (_settings?.LoginMfaRequirement ?? PanelLoginMfaRequirement.Optional) == PanelLoginMfaRequirement.RequiredForAll;

    /// <summary>
    /// Determines whether a panel login MFA requirement option is weaker than (and therefore superseded by) root policy.
    /// </summary>
    /// <param name="option">The workspace option value.</param>
    /// <returns><see langword="true"/> if blocked by root policy; otherwise, <see langword="false"/>.</returns>
    private bool IsLoginMfaOptionBlocked(PanelLoginMfaRequirement option)
    {
        PanelLoginMfaRequirement root = _settings?.LoginMfaRequirement ?? PanelLoginMfaRequirement.Optional;
        return (int)option < (int)root;
    }

    /// <summary>
    /// Determines whether the root instance policy fixes the step-up Sudo Mode policy.
    /// </summary>
    /// <returns><see langword="true"/> if root policy enforces Required; otherwise, <see langword="false"/>.</returns>
    private bool IsStepUpPolicyFixedByRoot() =>
        (_settings?.StepUpSudoPolicy ?? StepUpSudoPolicy.Required) == StepUpSudoPolicy.Required;

    /// <summary>
    /// Determines whether a step-up Sudo Mode option is blocked by root policy.
    /// </summary>
    /// <param name="option">The workspace option value.</param>
    /// <returns><see langword="true"/> if blocked by root policy; otherwise, <see langword="false"/>.</returns>
    private bool IsStepUpOptionBlocked(StepUpSudoPolicy option)
    {
        StepUpSudoPolicy root = _settings?.StepUpSudoPolicy ?? StepUpSudoPolicy.Required;
        return (int)option < (int)root;
    }

    /// <summary>
    /// Determines whether workspace-level External OIDC enforcement is blocked or superseded by root policy.
    /// </summary>
    /// <returns><see langword="true"/> if root OIDC mode is not <see cref="ExternalOidcLoginMode.Allowed"/>; otherwise, <see langword="false"/>.</returns>
    private bool IsExternalOidcBlockedByRoot() =>
        _settings?.ExternalOidcLoginMode != ExternalOidcLoginMode.Allowed;

    /// <summary>
    /// Determines whether the custom bot account override toggle is blocked by root policy or Tier-1 feature gate.
    /// </summary>
    /// <returns><see langword="true"/> if blocked; otherwise, <see langword="false"/>.</returns>
    private bool IsCustomBotOverrideBlockedByRoot() =>
        _botPolicy == InstanceBotAccountPolicy.DefaultOnly
        || (_botPolicy == InstanceBotAccountPolicy.DefaultWithOptionalOverride && !_customBotFeatureAllowed);

    /// <summary>
    /// Determines whether custom OAuth app configuration for <paramref name="platformId"/> is blocked by root policy or Tier-1 feature gate.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns><see langword="true"/> if blocked; otherwise, <see langword="false"/>.</returns>
    private bool IsCustomOAuthBlockedByRoot(string platformId)
    {
        InstanceOAuthAppPolicy effectiveOAuthPolicy = GetEffectiveOAuthPolicy(platformId);
        return effectiveOAuthPolicy == InstanceOAuthAppPolicy.InstanceOnly
            || (effectiveOAuthPolicy == InstanceOAuthAppPolicy.InstanceWithOptionalOverride && !_customOAuthFeatureAllowed);
    }

    /// <summary>
    /// Formats a dropdown option label, appending <c> (blocked by root policy)</c> when blocked.
    /// </summary>
    /// <param name="label">The base option label.</param>
    /// <param name="isBlocked">Whether the option is blocked by root policy.</param>
    /// <returns>The formatted option label.</returns>
    private static string FormatOptionLabel(string label, bool isBlocked) =>
        isBlocked ? $"{label} (blocked by root policy)" : label;

