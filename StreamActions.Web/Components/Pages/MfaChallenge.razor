@page "/auth/mfa"
@attribute [Authorize(Policy = AuthClaims.MfaPendingPolicy)]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.DependencyInjection
@using StreamActions.Core.Abstractions
@using StreamActions.Core.Models
@using StreamActions.Core.Models.Entities

@inject AuthenticationStateProvider AuthStateProvider
@inject IMfaPolicyService MfaPolicyService
@inject IServiceProvider ServiceProvider

<PageTitle>@AuthPolicyParser.FormatPageTitle("Two-Factor Authentication", _instanceName)</PageTitle>

<h1>Two-Factor Authentication</h1>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <p role="alert" data-mfa-error="@Error">Verification failed. Please check your code or security key and try again.</p>
}

@if (!_loaded)
{
    <p>Loading authentication options…</p>
}
else if (_policy.IsMfaDisabled)
{
    <p role="alert">All multi-factor authentication methods are currently disabled by policy.</p>
}
else
{
    <div data-mfa-challenge="true">
    <p>Verify your identity to complete signing in to StreamActions.</p>

    @if (_policy.IsPasskeyAllowed)
    {
        <section aria-labelledby="mfa-passkey-heading">
            <h2 id="mfa-passkey-heading">Passkey</h2>
            <button type="button"
                    data-mfa-passkey="true"
                    data-return-url="@_safeReturnUrl"
                    data-workspace-id="@(WorkspaceId.HasValue ? WorkspaceId.Value.ToString("D") : string.Empty)"
                    onclick="window.streamActionsWebAuthn && window.streamActionsWebAuthn.verifyPasskey(this.dataset.returnUrl, 'mfa-passkey-error', this.dataset.workspaceId)">
                Verify with Passkey
            </button>
            <p id="mfa-passkey-error" role="alert" hidden></p>
        </section>
    }

    @if (_policy.IsTotpAllowed)
    {
        <section aria-labelledby="mfa-totp-heading">
            <h2 id="mfa-totp-heading">Authenticator App (TOTP)</h2>
            <button type="button"
                    data-mfa-toggle-totp="true"
                    data-mfa-target-method="totp"
                    data-mfa-container="[data-mfa-challenge]"
                    aria-expanded="@(_activeMethod == "totp" ? "true" : "false")"
                    @onclick="ShowTotpForm">
                Use Authenticator App (TOTP)
            </button>
            <form method="post" action="/auth/mfa/totp/verify" data-mfa-totp="true" hidden="@(_activeMethod != "totp")">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@_safeReturnUrl" />
                @if (WorkspaceId.HasValue && WorkspaceId.Value != Guid.Empty)
                {
                    <input type="hidden" name="workspaceId" value="@WorkspaceId.Value.ToString("D")" />
                }
                <div>
                    <label for="mfa-totp-code">6-digit code</label>
                    <input id="mfa-totp-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" @bind="_totpCode" @bind:event="oninput" required />
                </div>
                <button type="submit">Verify Code</button>
            </form>
        </section>
    }

    <section aria-labelledby="mfa-recovery-heading">
        <h2 id="mfa-recovery-heading">One-Time Recovery Code</h2>
        <button type="button"
                data-mfa-toggle-recovery="true"
                data-mfa-target-method="recovery"
                data-mfa-container="[data-mfa-challenge]"
                aria-expanded="@(_activeMethod == "recovery" ? "true" : "false")"
                @onclick="ShowRecoveryForm">
            Use a Recovery Code
        </button>
        <form method="post" action="/auth/mfa/recovery/verify" data-mfa-recovery="true" hidden="@(_activeMethod != "recovery")">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@_safeReturnUrl" />
            @if (WorkspaceId.HasValue && WorkspaceId.Value != Guid.Empty)
            {
                <input type="hidden" name="workspaceId" value="@WorkspaceId.Value.ToString("D")" />
            }
            <div>
                <label for="mfa-recovery-code">Recovery Code</label>
                <input id="mfa-recovery-code" name="code" type="text" autocomplete="off" @bind="_recoveryCode" @bind:event="oninput" required />
            </div>
            <button type="submit">Verify Recovery Code</button>
        </form>
    </section>
    </div>
}

@code {
    /// <summary>
    /// Gets or sets the optional local return URL requested prior to MFA challenge.
    /// </summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    /// <summary>
    /// Gets or sets the optional verification error code.
    /// </summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    /// <summary>
    /// Gets or sets the optional target workspace identifier triggering this MFA challenge.
    /// </summary>
    [SupplyParameterFromQuery(Name = "workspaceId")]
    public Guid? WorkspaceId { get; set; }

    /// <summary>
    /// Indicates whether policy evaluation has completed.
    /// </summary>
    private bool _loaded;

    /// <summary>
    /// Validated safe local return URL.
    /// </summary>
    private string _safeReturnUrl = "/";

    /// <summary>
    /// Effective MFA policy governing permitted challenge methods.
    /// </summary>
    private EffectiveMfaPolicy _policy = new(
        MfaMethodAvailability.Allowed,
        MfaMethodAvailability.Allowed,
        PanelLoginMfaRequirement.Optional,
        StepUpSudoPolicy.Required);

    /// <summary>
    /// Operator-configured instance display name.
    /// </summary>
    private string _instanceName = AuthPolicyParser.DefaultInstanceName;

    /// <summary>
    /// Indicates whether the user currently has at least one enrolled WebAuthn passkey.
    /// </summary>
    private bool _hasPasskeyEnrolled;

    /// <summary>
    /// Currently revealed secondary input method (<c>"totp"</c>, <c>"recovery"</c>, or <see langword="null"/> when collapsed).
    /// </summary>
    private string? _activeMethod;

    /// <summary>
    /// Bound TOTP verification code input value.
    /// </summary>
    private string _totpCode = string.Empty;

    /// <summary>
    /// Bound recovery code input value.
    /// </summary>
    private string _recoveryCode = string.Empty;

    /// <summary>
    /// Loads the current user's effective MFA policy to determine which verification methods may be presented.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous initialization operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        IInstanceSettingsService? settingsService = ServiceProvider.GetService<IInstanceSettingsService>();
        if (settingsService is not null)
        {
            InstanceSettings settings = await settingsService.GetAsync();
            _instanceName = AuthPolicyParser.ResolveInstanceName(settings);
        }
        _safeReturnUrl = AuthClaims.SafeReturnUrlOrDefault(ReturnUrl, "/");

        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal principal = authState.User;

        IPanelUserStore? panelUserStore = ServiceProvider.GetService<IPanelUserStore>();
        IMfaCredentialStore? mfaCredentialStore = ServiceProvider.GetService<IMfaCredentialStore>();
        Guid? userId = AuthClaims.GetPanelUserId(principal);
        PanelUser? user = panelUserStore is not null && userId.HasValue
            ? await panelUserStore.GetByIdAsync(userId.Value)
            : null;

        if (user is not null && panelUserStore is not null)
        {
            IReadOnlyList<UserLoginIdentity> identities = await panelUserStore
                .GetLoginIdentitiesAsync(user.Id);
            IReadOnlyList<string> oidcGroups = AuthClaims.GetOidcGroups(principal);

            _policy = await MfaPolicyService
                .GetEffectivePolicyForUserAsync(user, identities, oidcGroups, workspaceId: WorkspaceId);
        }
        else
        {
            _policy = await MfaPolicyService
                .GetEffectivePolicyAsync(workspaceId: WorkspaceId);
        }

        if (mfaCredentialStore is not null && userId.HasValue)
        {
            IReadOnlyList<MfaCredentialSummary> summaries = await mfaCredentialStore
                .GetSummariesAsync(userId.Value);
            _hasPasskeyEnrolled = summaries.Any(static s => s.Method == MfaMethod.Passkey);
        }
        else
        {
            _hasPasskeyEnrolled = false;
        }

        _activeMethod = (_hasPasskeyEnrolled && _policy.IsPasskeyAllowed && _policy.IsTotpAllowed)
            ? null
            : (_policy.IsTotpAllowed ? "totp" : null);

        _loaded = true;
    }

    /// <summary>
    /// Reveals the TOTP verification form, hides the recovery code form, and clears both code inputs.
    /// </summary>
    private void ShowTotpForm()
    {
        _totpCode = string.Empty;
        _recoveryCode = string.Empty;
        _activeMethod = "totp";
    }

    /// <summary>
    /// Reveals the recovery code verification form, hides the TOTP form, and clears both code inputs.
    /// </summary>
    private void ShowRecoveryForm()
    {
        _totpCode = string.Empty;
        _recoveryCode = string.Empty;
        _activeMethod = "recovery";
    }
}

