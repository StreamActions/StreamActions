@page "/account/mfa"
@attribute [Authorize(Policy = AuthClaims.MfaPendingPolicy)]
@implements IDisposable
@rendermode InteractiveServer

@using System.Security.Claims
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.DependencyInjection
@using StreamActions.Core.Abstractions
@using StreamActions.Core.Models
@using StreamActions.Core.Models.Entities
@using StreamActions.Web.Components.Security

@inject AuthenticationStateProvider AuthStateProvider
@inject IMfaCredentialStore MfaCredentialStore
@inject IMfaPolicyService MfaPolicyService
@inject IEnumerable<IPlatformOAuthProvider> PlatformProviders
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider

<PageTitle>@AuthPolicyParser.FormatPageTitle("Security & MFA", _instanceName)</PageTitle>

<h1>Security &amp; Multi-Factor Authentication</h1>

@if (EnrollRequired == true || _isEnrollmentRequiredClaim)
{
    <div role="alert" data-mfa-enroll-required="true">
        <p>
            <strong>Login MFA enrollment is required</strong> before you can enter the panel.
            Enroll a Passkey or Authenticator App below to complete your sign-in.
        </p>
    </div>
}

@if (_mfaResetByAdminNoticePending)
{
    <div role="alert" data-mfa-admin-reset-notice="true">
        <p>Your multi-factor authentication credentials were removed by an instance administrator.</p>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <p role="status" data-account-mfa-status="true">@_statusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p role="alert" data-account-mfa-error="true">@_errorMessage</p>
}

<StepUpMfaGuard RequireEvenIfPolicyOptional="true"
                OperationDescription="Verify your identity before viewing or modifying your multi-factor authentication credentials and linked accounts.">
<section aria-labelledby="enrolled-mfa-heading">
    <h2 id="enrolled-mfa-heading">Enrolled MFA Credentials</h2>
    @if (_summaries.Count == 0)
    {
        <p>No multi-factor authentication credentials are currently enrolled.</p>
    }
    else
    {
        <ul>
            @foreach (MfaCredentialSummary summary in _summaries)
            {
                <li data-mfa-credential-id="@summary.Id.ToString("D")">
                    <strong>@summary.Method</strong>
                    @if (!string.IsNullOrWhiteSpace(summary.DisplayName))
                    {
                        <span> — @summary.DisplayName</span>
                    }
                    <span> (Added @summary.CreatedAtUtc.ToString("u"))</span>
                    @if (summary.Method == MfaMethod.Totp)
                    {
                        <span> — @summary.RemainingRecoveryCodesCount recovery code(s) remaining</span>
                    }
                    @if (!_isMfaPending)
                    {
                        <button type="button" @onclick="() => DeleteCredentialAsync(summary.Id)">Remove</button>
                    }
                </li>
            }
        </ul>
    }
</section>

@if (_policy.IsPasskeyAllowed)
{
    <section aria-labelledby="passkey-enroll-heading" data-passkey-enroll-section="true">
        <h2 id="passkey-enroll-heading">Register a Passkey</h2>
        <div>
            <label for="passkey-display-name">Passkey Name (optional)</label>
            <input id="passkey-display-name" type="text" @bind="_passkeyName" placeholder="e.g. Hardware Security Key" autocomplete="off" />
        </div>
        <button type="button" data-register-passkey="true" @onclick="RegisterPasskeyAsync">Register Passkey</button>
    </section>
}

@if (_policy.IsTotpAllowed)
{
    <section aria-labelledby="totp-enroll-heading" data-totp-enroll-section="true">
        <h2 id="totp-enroll-heading">Authenticator App (TOTP)</h2>
        @if (_pendingTotpSecret is null)
        {
            <button type="button" data-totp-begin="true" @onclick="BeginTotpEnrollmentAsync">Set Up Authenticator App</button>
        }
        else
        {
            <div data-totp-pending="true">
                <p>Scan this QR code or add the key below to your authenticator app:</p>
                @if (!string.IsNullOrWhiteSpace(_pendingTotpQrSvg))
                {
                    <div data-totp-qr="true" aria-label="Authenticator App QR Code">
                        @((MarkupString)_pendingTotpQrSvg)
                    </div>
                }
                <p>Issuer: <strong data-totp-issuer="true">@_totpIssuerName</strong></p>
                <p>Secret Key: <code data-totp-secret="true">@_pendingTotpSecret</code></p>
                @if (!string.IsNullOrWhiteSpace(_pendingOtpAuthUri))
                {
                    <p>Provisioning URI: <code data-totp-uri="true">@_pendingOtpAuthUri</code></p>
                }
                <div>
                    <label for="totp-confirm-code">6-digit verification code</label>
                    <input id="totp-confirm-code" type="text" inputmode="numeric" autocomplete="one-time-code" @bind="_totpConfirmCode" />
                </div>
                <button type="button" data-totp-confirm="true" @onclick="ConfirmTotpEnrollmentAsync">Confirm TOTP Enrollment</button>
                <button type="button" @onclick="CancelTotpEnrollment">Cancel</button>
            </div>
        }

        @if (_revealedRecoveryCodes is { Count: > 0 })
        {
            <div role="region" aria-labelledby="recovery-codes-heading" data-recovery-codes="true">
                <h3 id="recovery-codes-heading">Save Your One-Time Recovery Codes</h3>
                <p>Store these recovery codes in a safe place. Each code can only be used once and will not be shown again.</p>
                <ul>
                    @foreach (string recoveryCode in _revealedRecoveryCodes)
                    {
                        <li><code>@recoveryCode</code></li>
                    }
                </ul>
                <p>
                    <a href="@_safeReturnUrl">Continue</a>
                </p>
            </div>
        }
    </section>
}

<section aria-labelledby="account-linked-identities-heading">
    <h2 id="account-linked-identities-heading">Linked External Accounts</h2>
    @if (_linkedIdentities.Count == 0)
    {
        <p>No external login identities linked.</p>
    }
    else
    {
        <ul>
            @foreach (UserLoginIdentity identity in _linkedIdentities)
            {
                <li>
                    <strong>@identity.ProviderId</strong>: @identity.ProviderUsername (<code>@identity.ProviderUserId</code>)
                </li>
            }
        </ul>
    }

    @if (!_isMfaPending)
    {
        <div>
            @foreach (string platformId in _availablePlatforms)
            {
                <a href="/auth/@Uri.EscapeDataString(platformId)/login?flow=link&returnUrl=%2Faccount%2Fmfa">
                    Link @platformId Account
                </a>
            }
        </div>
    }
</section>

@if (!_isMfaPending)
{
    <section aria-labelledby="account-active-sessions-heading" data-account-sessions-section="true">
        <h2 id="account-active-sessions-heading">Active Sessions</h2>
        <p>Terminate all other active web sessions across your devices while keeping this session signed in.</p>
        <button type="button" data-revoke-other-sessions="true" @onclick="RevokeOtherSessionsAsync">
            Log Out of All Other Sessions
        </button>
    </section>
}
</StepUpMfaGuard>

@code {
    /// <summary>
    /// Gets or sets a value indicating whether login MFA enrollment is required before accessing the panel.
    /// </summary>
    [SupplyParameterFromQuery(Name = "enrollRequired")]
    public bool? EnrollRequired { get; set; }

    /// <summary>
    /// Gets or sets the optional local return URL requested prior to MFA enrollment.
    /// </summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    /// <summary>
    /// Available streaming platform identifiers for account linking.
    /// </summary>
    private List<string> _availablePlatforms = ["twitch"];

    /// <summary>
    /// Authenticated panel user identifier.
    /// </summary>
    private Guid? _panelUserId;

    /// <summary>
    /// Active session identifier extracted from the <see cref="AuthClaims.SessionIdClaimType"/> claim.
    /// </summary>
    private Guid? _currentSessionId;

    /// <summary>
    /// Active subscription handle for <see cref="UserSessionsRevokedEvent"/> notifications on <see cref="IEventBus"/>.
    /// </summary>
    private IDisposable? _sessionRevocationSubscription;

    /// <summary>
    /// Indicates whether the current session is still awaiting MFA completion or enrollment.
    /// </summary>
    private bool _isMfaPending;

    /// <summary>
    /// Indicates whether the current principal carries <see cref="AuthClaims.MfaEnrollmentRequiredClaimType"/>.
    /// </summary>
    private bool _isEnrollmentRequiredClaim;

    /// <summary>
    /// Indicates whether an administrator recently removed this user's MFA credentials.
    /// </summary>
    private bool _mfaResetByAdminNoticePending;

    /// <summary>
    /// Validated safe local return URL.
    /// </summary>
    private string _safeReturnUrl = "/";

    /// <summary>
    /// Effective MFA policy governing allowed enrollment methods.
    /// </summary>
    private EffectiveMfaPolicy _policy = new(
        MfaMethodAvailability.Allowed,
        MfaMethodAvailability.Allowed,
        PanelLoginMfaRequirement.Optional,
        StepUpSudoPolicy.Required);

    /// <summary>
    /// Enrolled MFA credential metadata summaries.
    /// </summary>
    private IReadOnlyList<MfaCredentialSummary> _summaries = [];

    /// <summary>
    /// Linked external login identities for the current user.
    /// </summary>
    private IReadOnlyList<UserLoginIdentity> _linkedIdentities = [];

    /// <summary>
    /// Optional friendly display name for a newly registered passkey.
    /// </summary>
    private string _passkeyName = string.Empty;

    /// <summary>
    /// Pending Base32 TOTP secret during enrollment.
    /// </summary>
    private string? _pendingTotpSecret;

    /// <summary>
    /// Pending <c>otpauth://</c> provisioning URI during TOTP enrollment.
    /// </summary>
    private string? _pendingOtpAuthUri;

    /// <summary>
    /// Pending inline SVG QR code rendered from <see cref="_pendingOtpAuthUri"/>.
    /// </summary>
    private string? _pendingTotpQrSvg;

    /// <summary>
    /// User-entered 6-digit TOTP confirmation code.
    /// </summary>
    private string _totpConfirmCode = string.Empty;

    /// <summary>
    /// Newly generated plaintext recovery codes shown once after TOTP confirmation.
    /// </summary>
    private IReadOnlyList<string>? _revealedRecoveryCodes;

    /// <summary>
    /// Status banner message.
    /// </summary>
    private string? _statusMessage;

    /// <summary>
    /// Error banner message.
    /// </summary>
    private string? _errorMessage;

    /// <summary>
    /// Operator-configured instance display name.
    /// </summary>
    private string _instanceName = AuthPolicyParser.DefaultInstanceName;

    /// <summary>
    /// Operator-configured TOTP issuer display name.
    /// </summary>
    private string _totpIssuerName = AuthPolicyParser.DefaultInstanceName;

    /// <summary>
    /// Initializes enrolled credentials, effective MFA policy, and linked external identities.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous initialization operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        IInstanceSettingsService? settingsService = ServiceProvider.GetService<IInstanceSettingsService>();
        if (settingsService is not null)
        {
            InstanceSettings settings = await settingsService.GetAsync().ConfigureAwait(false);
            _instanceName = AuthPolicyParser.ResolveInstanceName(settings);
            _totpIssuerName = AuthPolicyParser.ResolveTotpIssuerName(settings);
        }
        List<string> discoveredPlatforms = [.. PlatformProviders
            .Select(static p => p.PlatformId)
            .Where(static p => !string.IsNullOrWhiteSpace(p))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(static p => p, StringComparer.OrdinalIgnoreCase)];
        if (discoveredPlatforms.Count > 0)
        {
            _availablePlatforms = discoveredPlatforms;
        }

        _safeReturnUrl = AuthClaims.SafeReturnUrlOrDefault(ReturnUrl, "/");

        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
        ClaimsPrincipal principal = authState.User;
        _panelUserId = AuthClaims.GetPanelUserId(principal);
        _currentSessionId = AuthClaims.GetSessionId(principal);
        _isMfaPending = AuthClaims.HasTrueClaim(principal, AuthClaims.MfaPendingClaimType);
        _isEnrollmentRequiredClaim = AuthClaims.HasTrueClaim(principal, AuthClaims.MfaEnrollmentRequiredClaimType);

        IEventBus? eventBus = ServiceProvider.GetService<IEventBus>();
        if (eventBus is not null)
        {
            _sessionRevocationSubscription = eventBus.Subscribe<UserSessionsRevokedEvent>(HandleUserSessionsRevokedAsync);
        }

        IPanelUserStore? panelUserStore = ServiceProvider.GetService<IPanelUserStore>();
        PanelUser? user = panelUserStore is not null && _panelUserId.HasValue
            ? await panelUserStore.GetByIdAsync(_panelUserId.Value).ConfigureAwait(false)
            : null;

        if (user is not null && panelUserStore is not null)
        {
            _mfaResetByAdminNoticePending = user.MfaResetByAdminNoticePending;
            _linkedIdentities = await panelUserStore
                .GetLoginIdentitiesAsync(user.Id)
                .ConfigureAwait(false);
            IReadOnlyList<string> oidcGroups = AuthClaims.GetOidcGroups(principal);
            _policy = await MfaPolicyService
                .GetEffectivePolicyForUserAsync(user, _linkedIdentities, oidcGroups, workspaceId: null)
                .ConfigureAwait(false);
        }
        else
        {
            _policy = await MfaPolicyService
                .GetEffectivePolicyAsync(workspaceId: null)
                .ConfigureAwait(false);
        }

        await ReloadSummariesAsync().ConfigureAwait(false);
    }

    /// <summary>
    /// Reloads the user's enrolled MFA credential summaries.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous load operation.</returns>
    private async Task ReloadSummariesAsync() =>
        _summaries = _panelUserId.HasValue
            ? await MfaCredentialStore.GetSummariesAsync(_panelUserId.Value).ConfigureAwait(false)
            : [];

    /// <summary>
    /// Initiates WebAuthn passkey registration via <c>window.streamActionsWebAuthn.registerPasskey</c>.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous registration operation.</returns>
    private async Task RegisterPasskeyAsync()
    {
        ClearMessages();
        string redirectTarget = (EnrollRequired == true || _isEnrollmentRequiredClaim)
            ? _safeReturnUrl
            : "/account/mfa";

        try
        {
            _ = await JS.InvokeAsync<object?>(
                "streamActionsWebAuthn.registerPasskey",
                _passkeyName,
                redirectTarget).ConfigureAwait(false);
        }
        catch (JSException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Initiates TOTP enrollment by requesting a Base32 secret and <c>otpauth://</c> URI from <c>/auth/mfa/totp/enroll/begin</c>.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
    private async Task BeginTotpEnrollmentAsync()
    {
        ClearMessages();
        _revealedRecoveryCodes = null;

        try
        {
            TotpEnrollBeginDto result = await JS
                .InvokeAsync<TotpEnrollBeginDto>("streamActionsWebAuthn.beginTotpEnrollment")
                .ConfigureAwait(false);

            _pendingTotpSecret = result.SecretBase32;
            _pendingOtpAuthUri = result.OtpAuthUri;
            if (!string.IsNullOrWhiteSpace(result.IssuerName))
            {
                _totpIssuerName = result.IssuerName.Trim();
            }

            _pendingTotpQrSvg = !string.IsNullOrWhiteSpace(_pendingOtpAuthUri)
                ? QrCodeSvgGenerator.GenerateSvg(_pendingOtpAuthUri)
                : null;
            _totpConfirmCode = string.Empty;
        }
        catch (JSException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Confirms TOTP enrollment with the 6-digit verification code and reveals the generated one-time recovery codes.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous confirmation operation.</returns>
    private async Task ConfirmTotpEnrollmentAsync()
    {
        ClearMessages();
        if (string.IsNullOrWhiteSpace(_totpConfirmCode))
        {
            _errorMessage = "Enter the 6-digit code from your authenticator app.";
            return;
        }

        try
        {
            TotpEnrollConfirmDto result = await JS
                .InvokeAsync<TotpEnrollConfirmDto>("streamActionsWebAuthn.confirmTotpEnrollment", _totpConfirmCode.Trim())
                .ConfigureAwait(false);

            _pendingTotpSecret = null;
            _pendingOtpAuthUri = null;
            _pendingTotpQrSvg = null;
            _totpConfirmCode = string.Empty;
            _revealedRecoveryCodes = result.RecoveryCodes ?? [];
            _isMfaPending = false;
            _isEnrollmentRequiredClaim = false;
            await ReloadSummariesAsync().ConfigureAwait(false);
            _statusMessage = "Authenticator app enrolled. Save your recovery codes below.";
        }
        catch (JSException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Cancels in-progress TOTP enrollment.
    /// </summary>
    private void CancelTotpEnrollment()
    {
        _pendingTotpSecret = null;
        _pendingOtpAuthUri = null;
        _pendingTotpQrSvg = null;
        _totpConfirmCode = string.Empty;
    }

    /// <summary>
    /// Deletes an enrolled MFA credential owned by the current user.
    /// </summary>
    /// <param name="credentialId">The credential record identifier.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous delete operation.</returns>
    private async Task DeleteCredentialAsync(Guid credentialId)
    {
        ClearMessages();
        if (!_panelUserId.HasValue || _isMfaPending)
        {
            _errorMessage = "Complete MFA verification before modifying credentials.";
            return;
        }

        bool deleted = await MfaCredentialStore
            .DeleteCredentialAsync(_panelUserId.Value, credentialId)
            .ConfigureAwait(false);

        if (!deleted)
        {
            _errorMessage = "MFA credential was not found.";
            return;
        }

        await ReloadSummariesAsync().ConfigureAwait(false);
        _statusMessage = "Removed MFA credential.";
    }

    /// <summary>
    /// Revokes all active panel sessions for the current user other than the current session.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous revocation operation.</returns>
    private async Task RevokeOtherSessionsAsync()
    {
        ClearMessages();
        if (!_panelUserId.HasValue || _isMfaPending)
        {
            _errorMessage = "Complete MFA verification before revoking sessions.";
            return;
        }

        IPanelSessionService? sessionService = ServiceProvider.GetService<IPanelSessionService>();
        if (sessionService is null)
        {
            _errorMessage = "Session tracking service is not available.";
            return;
        }

        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
        Guid currentSessionId = AuthClaims.GetSessionId(authState.User) ?? _currentSessionId ?? Guid.Empty;
        int revokedCount = await sessionService
            .RevokeOtherSessionsAsync(_panelUserId.Value, currentSessionId)
            .ConfigureAwait(false);

        _statusMessage = $"Logged out of {revokedCount} other session(s).";
    }

    /// <summary>
    /// Redirects the active Blazor circuit to <c>/login?error=session_revoked</c> when the current user's session is revoked.
    /// </summary>
    /// <param name="evt">The session revocation event payload.</param>
    /// <param name="cancellationToken">A token to monitor for cancellation requests.</param>
    /// <returns>A <see cref="ValueTask"/> representing the asynchronous handler execution.</returns>
    private async ValueTask HandleUserSessionsRevokedAsync(
        UserSessionsRevokedEvent evt,
        CancellationToken cancellationToken)
    {
        await InvokeAsync(async () =>
        {
            AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
            ClaimsPrincipal user = authState.User;
            Guid? currentUserId = AuthClaims.GetPanelUserId(user) ?? _panelUserId;
            Guid? currentSessionId = AuthClaims.GetSessionId(user) ?? _currentSessionId;
            if (currentUserId == evt.PanelUserId
                && (evt.ExcludedSessionId is null || currentSessionId != evt.ExcludedSessionId))
            {
                Navigation.NavigateTo("/login?error=session_revoked", forceLoad: true);
            }
        }).ConfigureAwait(false);
    }

    /// <summary>
    /// Releases event bus subscriptions when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        _sessionRevocationSubscription?.Dispose();
        _sessionRevocationSubscription = null;
    }

    /// <summary>
    /// Clears visible status and error messages.
    /// </summary>
    private void ClearMessages()
    {
        _statusMessage = null;
        _errorMessage = null;
    }

    /// <summary>
    /// Deserialized response returned from <c>POST /auth/mfa/totp/enroll/begin</c>.
    /// </summary>
    internal sealed record TotpEnrollBeginDto
    {
        /// <summary>
        /// Gets the Base32 shared secret.
        /// </summary>
        [JsonPropertyName("secretBase32")]
        public string? SecretBase32 { get; init; }

        /// <summary>
        /// Gets the <c>otpauth://</c> provisioning URI string.
        /// </summary>
        [JsonPropertyName("otpAuthUri")]
        public string? OtpAuthUri { get; init; }

        /// <summary>
        /// Gets the resolved TOTP issuer label.
        /// </summary>
        [JsonPropertyName("issuerName")]
        public string? IssuerName { get; init; }
    }

    /// <summary>
    /// Deserialized response returned from <c>POST /auth/mfa/totp/enroll/confirm</c>.
    /// </summary>
    private sealed record TotpEnrollConfirmDto
    {
        /// <summary>
        /// Gets the newly generated plaintext recovery codes.
        /// </summary>
        [JsonPropertyName("recoveryCodes")]
        public IReadOnlyList<string>? RecoveryCodes { get; init; }
    }
}

