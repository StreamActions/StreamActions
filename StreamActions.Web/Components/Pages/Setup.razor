@page "/setup"
@page "/setup-recovery"

@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.DependencyInjection
@using StreamActions.Core.Abstractions
@using StreamActions.Core.Models
@using StreamActions.Core.Models.Entities
@using StreamActions.Core.Permissions
@using StreamActions.Web.Endpoints

@inject IBootstrapTokenService BootstrapTokenService
@inject IPanelUserStore PanelUserStore
@inject IServiceProvider ServiceProvider

<PageTitle>@AuthPolicyParser.FormatPageTitle(_isRootRecovery ? "Root Recovery" : "Initial Setup", _instanceName)</PageTitle>

<h1>@(_isRootRecovery ? "Root Recovery" : "Initial Setup")</h1>

@if (_isRootRecovery)
{
    <p data-setup-mode="recovery">Root Recovery mode: enter the bootstrap token printed to the daemon console to recover root operator access.</p>
}
else
{
    <p data-setup-mode="initial">Initial Setup mode: enter the bootstrap token printed to the daemon console to initialize this node.</p>
}

@if (_hasValidSetupTicket)
{
    <p role="status">
        Bootstrap token verified. Setup session cookie has been issued.
        <a href="/auth/@Uri.EscapeDataString(_ticketPlatformId)/login?flow=setup">Continue with @FormatPlatformName(_ticketPlatformId)</a>
    </p>
}

@if (!_tokenAvailable)
{
    int cooldownSeconds = Math.Max(1, (int)Math.Ceiling((_cooldownRemaining ?? TimeSpan.Zero).TotalSeconds));
    <p role="alert" data-setup-cooldown="true">
        Bootstrap token generation is in cooldown after repeated failed attempts. Please wait @cooldownSeconds second(s) before requesting a new token.
    </p>
}
else
{
    <form method="post" action="/setup/verify">
        <AntiforgeryToken />
        <div>
            <label for="bootstrap-token">Bootstrap Token</label>
            <input id="bootstrap-token" name="bootstrapToken" type="password" autocomplete="off" required />
        </div>
        <div>
            <label for="platform-id">Platform</label>
            <select id="platform-id" name="platformId">
                @foreach (string platformId in _availablePlatforms)
                {
                    <option value="@platformId" selected="@string.Equals(platformId, _selectedPlatformId, StringComparison.OrdinalIgnoreCase)">@FormatPlatformName(platformId)</option>
                }
            </select>
        </div>
        <div>
            <label for="client-id">@(_isRootRecovery && _hasStoredOAuthCredentials ? "OAuth Client ID (optional — existing instance credentials configured)" : "OAuth Client ID")</label>
            <input id="client-id" name="clientId" type="text" autocomplete="off" />
        </div>
        <div>
            <label for="client-secret">@(_isRootRecovery && _hasStoredOAuthCredentials ? "OAuth Client Secret (optional — leave blank to keep existing)" : "OAuth Client Secret")</label>
            <input id="client-secret" name="clientSecret" type="password" autocomplete="new-password" />
        </div>
        @if (_isRootRecovery)
        {
            <div data-setup-reset-mfa="true">
                <input type="hidden" name="resetMfaSubmitted" value="true" />
                <label for="reset-mfa">
                    <input id="reset-mfa" name="resetMfa" type="checkbox" value="true" checked />
                    Reset Root MFA credentials during recovery
                </label>
                <p>Recommended if you lost access to your passkey or authenticator app. Uncheck to keep existing MFA credentials and require an MFA challenge after OAuth verification.</p>
            </div>
        }
        else
        {
            <fieldset data-setup-dangerous-features="true">
                <legend>High-Risk / Advanced Features (Optional)</legend>
                <p>
                    By default, the <strong>@BuiltInPermissionKeys.DefaultWorkspacePlanGroupName</strong> global group grants standard streamer features
                    (commands, timers, quotes, counters, moderation, loyalty, overlays, soundboard, alerts, public portal, and Discord add-on) while leaving
                    the following 5 high-risk global features at <strong>Implicit Deny (Inherit)</strong> for multi-tenant security.
                    Check any advanced features you want enabled by default for streamer workspaces on this node:
                </p>
                <div>
                    <label for="enable-all-dangerous-features">
                        <input id="enable-all-dangerous-features" name="enableAllDangerousFeatures" type="checkbox" value="true" />
                        Enable all advanced features for streamer workspaces
                    </label>
                </div>
                <ul>
                    @foreach (PermissionDescriptor descriptor in _dangerousGlobalFeatures)
                    {
                        <li>
                            <label>
                                <input type="checkbox" name="enabledDangerousFeatures" value="@descriptor.Key" />
                                <strong>@descriptor.DisplayName</strong> (<code>@descriptor.Key</code>) — @descriptor.Description
                            </label>
                        </li>
                    }
                </ul>
            </fieldset>
        }
        <button type="submit">Verify &amp; Continue</button>
    </form>
}

@code {
    /// <summary>
    /// Available streaming platform identifiers discovered from DI.
    /// </summary>
    private List<string> _availablePlatforms = ["twitch"];

    /// <summary>
    /// Default selected platform identifier in the verification form.
    /// </summary>
    private string _selectedPlatformId = "twitch";

    /// <summary>
    /// Platform identifier stored in the active setup ticket (used for the Continue link).
    /// </summary>
    private string _ticketPlatformId = "twitch";

    /// <summary>
    /// Indicates whether at least one platform OAuth credential set is already stored in instance settings.
    /// </summary>
    private bool _hasStoredOAuthCredentials;

    /// <summary>
    /// Indicates whether an active bootstrap token is available for verification.
    /// </summary>
    private bool _tokenAvailable;

    /// <summary>
    /// Remaining cooldown duration when bootstrap token issuance is temporarily blocked.
    /// </summary>
    private TimeSpan? _cooldownRemaining;

    /// <summary>
    /// Indicates whether the node already has a root operator account and is in recovery mode.
    /// </summary>
    private bool _isRootRecovery;

    /// <summary>
    /// Indicates whether a valid setup ticket is active for continuing to platform OAuth.
    /// </summary>
    private bool _hasValidSetupTicket;

    /// <summary>
    /// Operator-configured instance display name.
    /// </summary>
    private string _instanceName = AuthPolicyParser.DefaultInstanceName;

    /// <summary>
    /// Registered dangerous global feature descriptors rendered as opt-in checkboxes during initial setup.
    /// </summary>
    private IReadOnlyList<PermissionDescriptor> _dangerousGlobalFeatures = [];

    /// <summary>
    /// Gets or sets the ambient HTTP context during static SSR rendering.
    /// </summary>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// Gets or sets a query flag indicating whether verification just succeeded.
    /// </summary>
    [SupplyParameterFromQuery]
    public bool? Verified { get; set; }

    /// <summary>
    /// Requests or reuses the console bootstrap token and checks whether a root user already exists.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous initialization operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        List<string> discoveredPlatforms = [.. ServiceProvider
            .GetServices<IPlatformOAuthProvider>()
            .Select(static p => p.PlatformId)
            .Where(static p => !string.IsNullOrWhiteSpace(p))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(static p => p, StringComparer.OrdinalIgnoreCase)];
        if (discoveredPlatforms.Count > 0)
        {
            _availablePlatforms = discoveredPlatforms;
            _selectedPlatformId = discoveredPlatforms.FirstOrDefault(static p => string.Equals(p, "twitch", StringComparison.OrdinalIgnoreCase))
                ?? discoveredPlatforms[0];
            _ticketPlatformId = _selectedPlatformId;
        }

        IInstanceSettingsService? settingsService = ServiceProvider.GetService<IInstanceSettingsService>();
        if (settingsService is not null)
        {
            InstanceSettings settings = await settingsService.GetAsync().ConfigureAwait(false);
            _instanceName = AuthPolicyParser.ResolveInstanceName(settings);
        }

        IPermissionRegistry permissionRegistry = ServiceProvider.GetService<IPermissionRegistry>() ?? new PermissionRegistry();
        _dangerousGlobalFeatures = [.. permissionRegistry
            .GetAll()
            .Where(static d => d.IsGloballyGated && d.IsDangerousGlobalFeature)];

        BootstrapTokenRequestResult tokenResult = BootstrapTokenService.RequestOrReuseActiveToken();
        _tokenAvailable = tokenResult.Succeeded;
        _cooldownRemaining = tokenResult.CooldownRemaining;
        _isRootRecovery = await PanelUserStore.HasRootUserAsync().ConfigureAwait(false);

        if (_isRootRecovery)
        {
            IInstanceOAuthConfigService? oauthConfigService = ServiceProvider.GetService<IInstanceOAuthConfigService>();
            if (oauthConfigService is not null)
            {
                IReadOnlyDictionary<string, PlatformOAuthAppCredentials> stored = await oauthConfigService.GetAllAsync().ConfigureAwait(false);
                _hasStoredOAuthCredentials = stored.Count > 0;
            }
        }

        SetupTicketPayload? ticket = null;
        if (HttpContext is not null)
        {
            IDataProtectionProvider? dataProtectionProvider = HttpContext.RequestServices.GetService<IDataProtectionProvider>();
            if (dataProtectionProvider is not null
                && SetupEndpoints.TryReadSetupTicket(HttpContext, dataProtectionProvider, out SetupTicketPayload? parsedTicket))
            {
                ticket = parsedTicket;
                _hasValidSetupTicket = true;
            }
        }

        if (!_hasValidSetupTicket)
        {
            _hasValidSetupTicket = Verified == true;
        }

        if (!string.IsNullOrWhiteSpace(ticket?.PlatformId))
        {
            _ticketPlatformId = ticket.PlatformId.Trim();
        }
    }

    /// <summary>
    /// Formats a lowercase platform identifier into a title-cased display name.
    /// </summary>
    /// <param name="platformId">The platform identifier.</param>
    /// <returns>The formatted display name.</returns>
    private static string FormatPlatformName(string platformId) =>
        CultureInfo.InvariantCulture.TextInfo.ToTitleCase(platformId.Trim());
}
