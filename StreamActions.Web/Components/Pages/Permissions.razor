    /// </summary>
    private string _auditPlatformId = "twitch";

    /// <summary>
    /// Audit target platform user identifier input.
    /// </summary>
    private string _auditPlatformUserId = string.Empty;

    /// <summary>
    /// Audit target display username input.
    /// </summary>
    private string _auditUsername = string.Empty;

    /// <summary>
    /// Audit target live platform designations.
    /// </summary>
    private PlatformUserDesignations _auditDesignations = PlatformUserDesignations.None;

    /// <summary>
    /// Computed effective permission audit breakdowns for the audited user.
    /// </summary>
    private IReadOnlyList<PermissionAuditBreakdown> _auditBreakdowns = [];

    /// <summary>
    /// Whether the current viewer holds Root or Global Administrator privileges.
    /// </summary>
    private bool _viewerIsRootOrGlobalAdmin;

    /// <summary>
    /// Whether the unsaved-changes confirmation prompt is currently displayed.
    /// </summary>
    private bool _showUnsavedNavigationPrompt;

    /// <summary>
    /// Pending target mode if the user confirms discarding unsaved changes.
    /// </summary>
    private PermissionsPageMode? _pendingTargetModeAfterDiscard;

    /// <summary>
    /// Pending internal navigation target URL if the user confirms discarding unsaved changes.
    /// </summary>
    private string? _pendingNavigationUrlAfterDiscard;

    /// <summary>
    /// Bypass flag set when executing a confirmed discard navigation so <see cref="OnBeforeInternalNavigationAsync"/> allows it through.
    /// </summary>
    private bool _bypassNavigationLockOnce;

    /// <summary>
    /// Status banner message.
    /// </summary>
    private string? _statusMessage;

    /// <summary>
    /// Event bus subscription for permission invalidation notifications.
    /// </summary>
    private IDisposable? _eventSubscription;

    /// <summary>
    /// Operator-configured instance display name.
    /// </summary>
    private string _instanceName = AuthPolicyParser.DefaultInstanceName;

    /// <summary>
    /// Gets the number of staged permission changes that differ from <see cref="_savedGrantStates"/>.
    /// </summary>
    private int UnsavedChangesCount
    {
        get
        {
            if (_currentMode != PermissionsPageMode.Edit || _selectedGroup is null)
            {
                return 0;
            }

            int count = 0;
            foreach (KeyValuePair<string, PermissionState> kvp in _pendingGrantStates)
            {
                PermissionState saved = _savedGrantStates.TryGetValue(kvp.Key, out PermissionState s)
                    ? s
                    : PermissionState.Inherit;
                if (kvp.Value != saved)
                {
                    count++;
                }
            }

            return count;
        }
    }

    /// <summary>
    /// Gets a value indicating whether the active edit session has any unsaved grant modifications.
    /// </summary>
    private bool HasUnsavedChanges => UnsavedChangesCount > 0;

    /// <summary>
    /// Gets a value indicating whether the self-escalation warning for <see cref="BuiltInPermissionKeys.UiPermissionsManage"/> is active.
    /// </summary>
    private bool IsSelfEscalationWarningActive
    {
        get
        {
            if (_currentMode != PermissionsPageMode.Edit || _selectedGroup is null)
            {
                return false;
            }

            PermissionState saved = _savedGrantStates.TryGetValue(BuiltInPermissionKeys.UiPermissionsManage, out PermissionState s)
                ? s
                : PermissionState.Inherit;
            PermissionState pending = _pendingGrantStates.TryGetValue(BuiltInPermissionKeys.UiPermissionsManage, out PermissionState p)
                ? p
                : PermissionState.Inherit;

            return saved != PermissionState.Allow && pending == PermissionState.Allow;
        }
    }

    /// <summary>
    /// Gets the list of permission descriptors filtered by <see cref="_selectedCategoryFilter"/>.
    /// </summary>
    private IReadOnlyList<PermissionDescriptor> FilteredDescriptorsByCategory =>
        string.IsNullOrWhiteSpace(_selectedCategoryFilter)
            ? _allDescriptors
            : [.. _allDescriptors.Where(d => string.Equals(d.Category, _selectedCategoryFilter, StringComparison.OrdinalIgnoreCase))];

    /// <summary>
    /// Gets the list of audit breakdowns filtered by <see cref="_selectedCategoryFilter"/>.
    /// </summary>
    private IReadOnlyList<PermissionAuditBreakdown> FilteredAuditBreakdowns =>
        string.IsNullOrWhiteSpace(_selectedCategoryFilter)
            ? _auditBreakdowns
            : [.. _auditBreakdowns.Where(b => string.Equals(b.Descriptor.Category, _selectedCategoryFilter, StringComparison.OrdinalIgnoreCase))];

    /// <summary>
    /// Gets all distinct group members across all groups in the active workspace for quick-picking in the audit launcher.
    /// </summary>
    private IReadOnlyList<PermissionGroupMember> AllDistinctMembers
    {
        get
        {
            Dictionary<string, PermissionGroupMember> distinct = new(StringComparer.OrdinalIgnoreCase);
            foreach (IReadOnlyList<PermissionGroupMember> members in _groupMembers.Values)
            {
                foreach (PermissionGroupMember member in members)
                {
                    string key = $"{member.PlatformId}:{member.PlatformUserId}";
                    _ = distinct.TryAdd(key, member);
                }
            }

            return [.. distinct.Values];
        }
    }

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        IInstanceSettingsService? settingsService = ServiceProvider.GetService<IInstanceSettingsService>();
        if (settingsService is not null)
        {
            InstanceSettings settings = await settingsService.GetAsync().ConfigureAwait(false);
            _instanceName = AuthPolicyParser.ResolveInstanceName(settings);
        }

        if (AuthenticationStateTask is not null)
        {
            AuthenticationState authState = await AuthenticationStateTask.ConfigureAwait(false);
            ClaimsPrincipal principal = authState.User;
            _viewerIsRootOrGlobalAdmin = AuthClaims.HasTrueClaim(principal, AuthClaims.IsRootClaimType)
                || AuthClaims.HasTrueClaim(principal, AuthClaims.IsGlobalAdminClaimType);
        }

        _categories = PermissionRegistry.GetCategories();
        _allDescriptors = PermissionRegistry.GetAll();
        _eventSubscription = EventBus.Subscribe<PermissionsInvalidatedEvent>(OnPermissionsInvalidatedAsync);
        WorkspaceSession.WorkspaceChanged += OnActiveWorkspaceChanged;

        await WorkspaceSession.InitializeAsync().ConfigureAwait(false);
        if (WorkspaceSession.ActiveWorkspaceId is Guid activeWorkspaceId)
        {
            _workspaceId = activeWorkspaceId;
            await LoadWorkspaceDataAsync().ConfigureAwait(false);
        }
    }

    /// <inheritdoc/>
    public void Dispose()
    {
        WorkspaceSession.WorkspaceChanged -= OnActiveWorkspaceChanged;
        _eventSubscription?.Dispose();
        _eventSubscription = null;
    }

    /// <summary>
    /// Synchronizes the page-level search query when updated from a child <see cref="DataTableGrid{TItem}"/>.
    /// </summary>
    /// <param name="newQuery">The new search query string.</param>
    private void OnSearchQueryChanged(string? newQuery)
    {
        _searchQuery = newQuery ?? string.Empty;
    }

    /// <summary>
    /// Handles active workspace changes triggered by the workspace session context.
    /// </summary>
    /// <param name="sender">The event sender.</param>
    /// <param name="args">The event arguments.</param>
    private void OnActiveWorkspaceChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(async () =>
        {
            Guid? activeWorkspaceId = WorkspaceSession.ActiveWorkspaceId;
            if (_workspaceId != activeWorkspaceId)
            {
                _workspaceId = activeWorkspaceId;
                _statusMessage = null;
                _currentMode = PermissionsPageMode.List;
                _selectedGroup = null;
                _isAuditView = false;
                _savedGrantStates.Clear();
                _pendingGrantStates.Clear();
                _showUnsavedNavigationPrompt = false;

                if (_workspaceId.HasValue)
                {
                    await LoadWorkspaceDataAsync();
                }
                else
                {
                    _workspace = null;
                    _groups = [];
                    _grantStates.Clear();
                    _groupMembers.Clear();
                }

                StateHasChanged();
            }
        });

    /// <summary>
    /// Predicate evaluating whether a <see cref="PermissionGroup"/> matches the search query (either by group name, designation, member, or matching permission).
    /// </summary>
    /// <param name="group">The permission group.</param>
    /// <param name="query">The trimmed search query.</param>
    /// <returns><see langword="true"/> if matched; otherwise, <see langword="false"/>.</returns>
    private bool MatchesGroupSearch(PermissionGroup group, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        if (group.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(group.MappedPlatformDesignation)
                && group.MappedPlatformDesignation.Contains(query, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(group.MappedOidcGroupClaim)
                && group.MappedOidcGroupClaim.Contains(query, StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        foreach (PermissionGroupMember member in GetMembersForGroup(group.Id))
        {
            if (MatchesMemberSearch(member, query))
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>
    /// Predicate evaluating whether a <see cref="PermissionDescriptor"/> matches the search query.
    /// </summary>
    /// <param name="descriptor">The permission descriptor.</param>
    /// <param name="query">The trimmed search query.</param>
    /// <returns><see langword="true"/> if matched; otherwise, <see langword="false"/>.</returns>
    private static bool MatchesDescriptorSearch(PermissionDescriptor descriptor, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return descriptor.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase)
            || descriptor.Key.Contains(query, StringComparison.OrdinalIgnoreCase)
            || descriptor.Category.Contains(query, StringComparison.OrdinalIgnoreCase)
            || descriptor.Description.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Predicate evaluating whether a <see cref="PermissionAuditBreakdown"/> matches the search query.
    /// </summary>
    /// <param name="breakdown">The permission audit breakdown.</param>
    /// <param name="query">The trimmed search query.</param>
    /// <returns><see langword="true"/> if matched; otherwise, <see langword="false"/>.</returns>
    private static bool MatchesAuditSearch(PermissionAuditBreakdown breakdown, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return MatchesDescriptorSearch(breakdown.Descriptor, query)
            || breakdown.DeterminedByDisplay.Contains(query, StringComparison.OrdinalIgnoreCase)
            || breakdown.SummaryReason.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Predicate evaluating whether a <see cref="PermissionGroupMember"/> matches the search query.
    /// </summary>
    /// <param name="member">The group member.</param>
    /// <param name="query">The trimmed search query.</param>
    /// <returns><see langword="true"/> if matched; otherwise, <see langword="false"/>.</returns>
    private static bool MatchesMemberSearch(PermissionGroupMember member, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return member.PlatformId.Contains(query, StringComparison.OrdinalIgnoreCase)
            || member.PlatformUserId.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(member.LastKnownUsername)
                && member.LastKnownUsername.Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Determines whether a permission group is a built-in role or OIDC-mapped group.
    /// </summary>
    /// <param name="group">The permission group.</param>
    /// <returns><see langword="true"/> if built-in; otherwise, <see langword="false"/>.</returns>
    private static bool IsBuiltInGroup(PermissionGroup group)
    {
        return !string.IsNullOrWhiteSpace(group.MappedPlatformDesignation)
            || !string.IsNullOrWhiteSpace(group.MappedOidcGroupClaim);
    }

    /// <summary>
    /// Retrieves the persisted permission grant state for a group and permission key.
    /// </summary>
    /// <param name="groupId">The group identifier.</param>
    /// <param name="permissionKey">The permission key.</param>
    /// <returns>The persisted <see cref="PermissionState"/>, defaulting to <see cref="PermissionState.Inherit"/>.</returns>
    private PermissionState GetSavedGrantState(Guid groupId, string permissionKey)
    {
        return _grantStates.TryGetValue((groupId, permissionKey), out PermissionState state)
            ? state
            : PermissionState.Inherit;
    }

    /// <summary>
    /// Retrieves the staged permission grant state for a permission key in <see cref="PermissionsPageMode.Edit"/>.
    /// </summary>
    /// <param name="permissionKey">The permission key.</param>
    /// <returns>The staged <see cref="PermissionState"/>, defaulting to <see cref="PermissionState.Inherit"/>.</returns>
    private PermissionState GetPendingGrantState(string permissionKey)
    {
        return _pendingGrantStates.TryGetValue(permissionKey, out PermissionState state)
            ? state
            : PermissionState.Inherit;
    }

    /// <summary>
    /// Retrieves the cached members for a permission group.
    /// </summary>
    /// <param name="groupId">The group identifier.</param>
    /// <returns>The group's member list.</returns>
    private IReadOnlyList<PermissionGroupMember> GetMembersForGroup(Guid groupId)
    {
        return _groupMembers.TryGetValue(groupId, out IReadOnlyList<PermissionGroupMember>? members)
            ? members
            : [];
    }

    /// <summary>
    /// Transitions into <see cref="PermissionsPageMode.View"/> for the specified group.
    /// </summary>
    /// <param name="group">The group to view.</param>
    private void EnterViewGroupMode(PermissionGroup group)
    {
        _selectedGroup = group;
        _isAuditView = false;
        _selectedCategoryFilter = string.Empty;
        _showUnsavedNavigationPrompt = false;
        _currentMode = PermissionsPageMode.View;
    }

    /// <summary>
    /// Initializes the staged edit buffer for <paramref name="group"/> and transitions into <see cref="PermissionsPageMode.Edit"/>.
    /// </summary>
    /// <param name="group">The group to edit.</param>
    private void EnterEditGroupMode(PermissionGroup group)
    {
        _selectedGroup = group;
        _isAuditView = false;
        _selectedCategoryFilter = string.Empty;
        _showUnsavedNavigationPrompt = false;
        InitializeEditBuffer(group.Id);
        _currentMode = PermissionsPageMode.Edit;
    }

    /// <summary>
    /// Copies persisted grant states for <paramref name="groupId"/> into <see cref="_savedGrantStates"/> and <see cref="_pendingGrantStates"/>.
    /// </summary>
    /// <param name="groupId">The group identifier.</param>
    private void InitializeEditBuffer(Guid groupId)
    {
        _savedGrantStates.Clear();
        _pendingGrantStates.Clear();

        foreach (PermissionDescriptor descriptor in _allDescriptors)
        {
            PermissionState saved = GetSavedGrantState(groupId, descriptor.Key);
            _savedGrantStates[descriptor.Key] = saved;
            _pendingGrantStates[descriptor.Key] = saved;
        }

        _priorUiPermissionsManageState = _savedGrantStates.TryGetValue(BuiltInPermissionKeys.UiPermissionsManage, out PermissionState initialManageState)
            ? initialManageState
            : PermissionState.Inherit;
        _selfEscalationConfirmed = false;
    }

    /// <summary>
    /// Requests returning to <see cref="PermissionsPageMode.List"/>, prompting for confirmation if there are unsaved changes.
    /// </summary>
    private void RequestBackToGroups()
    {
        if (HasUnsavedChanges)
        {
            _pendingTargetModeAfterDiscard = PermissionsPageMode.List;
            _pendingNavigationUrlAfterDiscard = null;
            _showUnsavedNavigationPrompt = true;
            return;
        }

        _currentMode = PermissionsPageMode.List;
        _selectedGroup = null;
        _isAuditView = false;
        _showUnsavedNavigationPrompt = false;
    }

    /// <summary>
    /// Requests switching from <see cref="PermissionsPageMode.Edit"/> to <see cref="PermissionsPageMode.View"/>, prompting if there are unsaved changes.
    /// </summary>
    private void RequestSwitchToViewMode()
    {
        if (_selectedGroup is null)
        {
            return;
        }

        if (HasUnsavedChanges)
        {
            _pendingTargetModeAfterDiscard = PermissionsPageMode.View;
            _pendingNavigationUrlAfterDiscard = null;
            _showUnsavedNavigationPrompt = true;
            return;
        }

        EnterViewGroupMode(_selectedGroup);
    }

    /// <summary>
    /// Intercepts internal Blazor navigation when <see cref="HasUnsavedChanges"/> is <see langword="true"/>.
    /// </summary>
    /// <param name="context">The location changing context.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous handler.</returns>
    private Task OnBeforeInternalNavigationAsync(LocationChangingContext context)
    {
        if (_bypassNavigationLockOnce)
        {
            _bypassNavigationLockOnce = false;
            return Task.CompletedTask;
        }

        if (HasUnsavedChanges)
        {
            context.PreventNavigation();
            _pendingNavigationUrlAfterDiscard = context.TargetLocation;
            _pendingTargetModeAfterDiscard = null;
            _showUnsavedNavigationPrompt = true;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Discards staged permission edits and completes the pending mode transition or internal navigation.
    /// </summary>
    private void ConfirmDiscardAndNavigateAsync()
    {
        _showUnsavedNavigationPrompt = false;
        if (_selectedGroup is not null)
        {
            InitializeEditBuffer(_selectedGroup.Id);
        }

        if (!string.IsNullOrWhiteSpace(_pendingNavigationUrlAfterDiscard))
        {
            string targetUrl = _pendingNavigationUrlAfterDiscard;
            _pendingNavigationUrlAfterDiscard = null;
            _bypassNavigationLockOnce = true;
            Navigation.NavigateTo(targetUrl);
            return;
        }

        if (_pendingTargetModeAfterDiscard == PermissionsPageMode.View && _selectedGroup is not null)
        {
            _pendingTargetModeAfterDiscard = null;
            EnterViewGroupMode(_selectedGroup);
            return;
        }

        _pendingTargetModeAfterDiscard = null;
        _currentMode = PermissionsPageMode.List;
        _selectedGroup = null;
        _isAuditView = false;
    }

    /// <summary>
    /// Cancels the unsaved-changes discard prompt and stays in <see cref="PermissionsPageMode.Edit"/>.
    /// </summary>
    private void CancelDiscardNavigation()
    {
        _showUnsavedNavigationPrompt = false;
        _pendingTargetModeAfterDiscard = null;
        _pendingNavigationUrlAfterDiscard = null;
    }

    /// <summary>
    /// Updates a single permission's staged state in <see cref="_pendingGrantStates"/> without writing to the database.
    /// </summary>
    /// <param name="permissionKey">The permission key.</param>
    /// <param name="args">The change event arguments.</param>
    private void OnPendingGrantChanged(string permissionKey, ChangeEventArgs args)
    {
        if (!Enum.TryParse(args.Value?.ToString(), out PermissionState newState))
        {
            return;
        }

        ApplyPendingGrantState(permissionKey, newState);
    }

    /// <summary>
    /// Sets all registered permissions in <see cref="_pendingGrantStates"/> for the active group to <paramref name="targetState"/>.
    /// </summary>
    /// <param name="targetState">The target <see cref="PermissionState"/>.</param>
    private void SetAllPermissionsForActiveGroup(PermissionState targetState)
    {
        if (_selectedGroup is null)
        {
            return;
        }

        foreach (PermissionDescriptor descriptor in _allDescriptors)
        {
            ApplyPendingGrantState(descriptor.Key, targetState);
        }

        _statusMessage = $"Staged all permissions as {targetState} for '{_selectedGroup.Name}'. Click Save Changes to persist.";
    }

    /// <summary>
    /// Sets all permissions within <paramref name="category"/> in <see cref="_pendingGrantStates"/> for the active group to <paramref name="targetState"/>.
    /// </summary>
    /// <param name="category">The permission category name.</param>
    /// <param name="targetState">The target <see cref="PermissionState"/>.</param>
    private void SetCategoryPermissionsForActiveGroup(string category, PermissionState targetState)
    {
        if (_selectedGroup is null)
        {
            return;
        }

        IReadOnlyList<PermissionDescriptor> categoryDescriptors = PermissionRegistry.GetByCategory(category);
        foreach (PermissionDescriptor descriptor in categoryDescriptors)
        {
            ApplyPendingGrantState(descriptor.Key, targetState);
        }

        _statusMessage = $"Staged category '{category}' permissions as {targetState} for '{_selectedGroup.Name}'. Click Save Changes to persist.";
    }

    /// <summary>
    /// Applies a staged state change to <see cref="_pendingGrantStates"/> and tracks <see cref="BuiltInPermissionKeys.UiPermissionsManage"/> self-escalation transitions.
    /// </summary>
    /// <param name="permissionKey">The permission key.</param>
    /// <param name="newState">The new staged state.</param>
    private void ApplyPendingGrantState(string permissionKey, PermissionState newState)
    {
        if (string.Equals(permissionKey, BuiltInPermissionKeys.UiPermissionsManage, StringComparison.OrdinalIgnoreCase))
        {
            PermissionState currentPending = GetPendingGrantState(BuiltInPermissionKeys.UiPermissionsManage);
            if (newState == PermissionState.Allow && currentPending != PermissionState.Allow)
            {
                _priorUiPermissionsManageState = currentPending;
                _selfEscalationConfirmed = false;
            }
            else if (newState != PermissionState.Allow)
            {
                _selfEscalationConfirmed = false;
            }
        }

        _pendingGrantStates[permissionKey] = newState;
    }

    /// <summary>
    /// Confirms the self-escalation warning for granting <see cref="BuiltInPermissionKeys.UiPermissionsManage"/>.
    /// </summary>
    private void ConfirmSelfEscalation()
    {
        _selfEscalationConfirmed = true;
    }

    /// <summary>
    /// Cancels the self-escalation change on <see cref="BuiltInPermissionKeys.UiPermissionsManage"/> and reverts it to its prior state.
    /// </summary>
    private void CancelSelfEscalation()
    {
        _pendingGrantStates[BuiltInPermissionKeys.UiPermissionsManage] = _priorUiPermissionsManageState;
        _selfEscalationConfirmed = false;
    }

    /// <summary>
    /// Persists all modified grants for the active group in a single atomic batch call and invalidates the workspace permission cache once.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous save operation.</returns>
    private async Task SavePendingChangesAsync()
    {
        if (_workspaceId is not Guid workspaceId || _selectedGroup is null)
        {
            return;
        }

        if (IsSelfEscalationWarningActive && !_selfEscalationConfirmed)
        {
            _statusMessage = "Please confirm or cancel the Self-Escalation Warning before saving.";
            return;
        }

        Dictionary<string, PermissionState> changedGrants = new(StringComparer.OrdinalIgnoreCase);
        foreach (KeyValuePair<string, PermissionState> kvp in _pendingGrantStates)
        {
            PermissionState saved = _savedGrantStates.TryGetValue(kvp.Key, out PermissionState s)
                ? s
                : PermissionState.Inherit;
            if (kvp.Value != saved)
            {
                changedGrants[kvp.Key] = kvp.Value;
            }
        }

        if (changedGrants.Count == 0)
        {
            return;
        }

        Guid groupId = _selectedGroup.Id;
        string groupName = _selectedGroup.Name;

        await PermissionStore.SetGrantsBatchAsync(groupId, changedGrants);
        foreach (KeyValuePair<string, PermissionState> kvp in changedGrants)
        {
            if (kvp.Value == PermissionState.Inherit)
            {
                _ = _grantStates.Remove((groupId, kvp.Key));
            }
            else
            {
                _grantStates[(groupId, kvp.Key)] = kvp.Value;
            }

            _savedGrantStates[kvp.Key] = kvp.Value;
        }

        _priorUiPermissionsManageState = GetPendingGrantState(BuiltInPermissionKeys.UiPermissionsManage);
        _selfEscalationConfirmed = false;
        _showUnsavedNavigationPrompt = false;

        await PermissionService.InvalidateWorkspaceAsync(workspaceId);
        _statusMessage = $"Saved {changedGrants.Count} permission change(s) for '{groupName}'.";
    }

    /// <summary>
    /// Reverts all staged edits in <see cref="_pendingGrantStates"/> back to <see cref="_savedGrantStates"/>.
    /// </summary>
    private void RevertPendingChanges()
    {
        if (_selectedGroup is null)
        {
            return;
        }

        InitializeEditBuffer(_selectedGroup.Id);
        _showUnsavedNavigationPrompt = false;
        _statusMessage = $"Reverted unsaved changes for '{_selectedGroup.Name}'.";
    }

    /// <summary>
    /// Populates the user audit inputs when a member is selected from the quick-pick dropdown.
    /// </summary>
    /// <param name="args">The change event arguments.</param>
    private void OnQuickPickAuditMember(ChangeEventArgs args)
    {
        string? raw = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return;
        }

        int separatorIndex = raw.IndexOf(':', StringComparison.Ordinal);
        if (separatorIndex <= 0)
        {
            return;
        }

        string platformId = raw[..separatorIndex];
        string platformUserId = raw[(separatorIndex + 1)..];
        PermissionGroupMember? member = AllDistinctMembers.FirstOrDefault(
            m => string.Equals(m.PlatformId, platformId, StringComparison.OrdinalIgnoreCase)
                && string.Equals(m.PlatformUserId, platformUserId, StringComparison.OrdinalIgnoreCase));

        _auditPlatformId = platformId;
        _auditPlatformUserId = platformUserId;
        _auditUsername = member?.LastKnownUsername ?? platformUserId;
    }

    /// <summary>
    /// Toggles a <see cref="PlatformUserDesignations"/> flag on the user audit target input.
    /// </summary>
    /// <param name="flag">The designation flag to toggle.</param>
    /// <param name="args">The checkbox change event arguments.</param>
    private void ToggleAuditDesignation(PlatformUserDesignations flag, ChangeEventArgs args)
    {
        bool isChecked = args.Value is bool b && b;
        _auditDesignations = isChecked
            ? _auditDesignations | flag
            : _auditDesignations & ~flag;
    }

    /// <summary>
    /// Runs <see cref="IPermissionService.ExplainUserPermissionsAsync"/> for the configured target user and transitions to <see cref="PermissionsPageMode.View"/>.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous audit operation.</returns>
    private async Task LaunchUserAuditAsync()
    {
        if (_workspaceId is not Guid workspaceId)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_auditPlatformId) || string.IsNullOrWhiteSpace(_auditPlatformUserId))
        {
            _statusMessage = "Platform ID and Platform User ID are required to audit user permissions.";
            return;
        }

        string platformId = _auditPlatformId.Trim();
        string platformUserId = _auditPlatformUserId.Trim();
        string username = string.IsNullOrWhiteSpace(_auditUsername)
            ? platformUserId
            : _auditUsername.Trim();

        PlatformUserIdentity actor = new(
            PlatformId: platformId,
            PlatformUserId: platformUserId,
            Username: username,
            Designations: _auditDesignations);

        _auditBreakdowns = await PermissionService.ExplainUserPermissionsAsync(
            workspaceId,
            actor,
            viewerIsRootOrGlobalAdmin: _viewerIsRootOrGlobalAdmin);

        _auditTargetLabel = $"{username} ({platformId}:{platformUserId})";
        _selectedGroup = null;
        _isAuditView = true;
        _selectedCategoryFilter = string.Empty;
        _currentMode = PermissionsPageMode.View;
        _statusMessage = null;
    }

    /// <summary>
    /// Seeds built-in workspace permission groups for the active workspace.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
    private async Task SeedBuiltInGroupsAsync()
    {
        if (_workspaceId is not Guid workspaceId)
        {
            return;
        }

        await PermissionStore.SeedBuiltInWorkspaceGroupsAsync(workspaceId);
        await PermissionService.InvalidateWorkspaceAsync(workspaceId);
        await LoadWorkspaceDataAsync();
        _statusMessage = "Built-in workspace groups seeded.";
    }

    /// <summary>
    /// Creates a new custom workspace permission group with all permissions defaulting to <see cref="PermissionState.Inherit"/> (zero grant rows).
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
    private async Task CreateCustomGroupAsync()
    {
        if (_workspaceId is not Guid workspaceId)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_newGroupName))
        {
            _statusMessage = "Group name is required.";
            return;
        }

        PermissionGroup newGroup = new()
        {
            Id = Guid.NewGuid(),
            WorkspaceId = workspaceId,
            Name = _newGroupName.Trim()
        };

        _ = await PermissionStore.UpsertGroupAsync(newGroup);
        await PermissionService.InvalidateWorkspaceAsync(workspaceId);
        _newGroupName = string.Empty;
        await LoadWorkspaceDataAsync();
        _statusMessage = $"Created group '{newGroup.Name}'.";
    }

    /// <summary>
    /// Deletes a custom workspace permission group.
    /// </summary>
    /// <param name="groupId">The group identifier to delete.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
    private async Task DeleteGroupAsync(Guid groupId)
    {
        if (_workspaceId is not Guid workspaceId)
        {
            return;
        }

        await PermissionStore.DeleteGroupAsync(groupId);
        await PermissionService.InvalidateWorkspaceAsync(workspaceId);
        await LoadWorkspaceDataAsync();
        _statusMessage = "Deleted custom group.";
    }

    /// <summary>
    /// Adds a platform user as an explicit member of the currently selected permission group.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
    private async Task AddMemberToSelectedGroupAsync()
    {
        if (_workspaceId is not Guid workspaceId || _selectedGroup is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_newMemberPlatformId) || string.IsNullOrWhiteSpace(_newMemberPlatformUserId))
        {
            _statusMessage = "Platform ID and Platform User ID are required.";
            return;
        }

        PermissionGroupMember member = new()
        {
            Id = Guid.NewGuid(),
            GroupId = _selectedGroup.Id,
            PlatformId = _newMemberPlatformId.Trim(),
            PlatformUserId = _newMemberPlatformUserId.Trim(),
            LastKnownUsername = string.IsNullOrWhiteSpace(_newMemberUsername) ? null : _newMemberUsername.Trim(),
            AddedAtUtc = DateTimeOffset.UtcNow
        };

        await PermissionStore.AddGroupMemberAsync(member);
        await PermissionService.InvalidateWorkspaceAsync(workspaceId);
        _newMemberPlatformUserId = string.Empty;
        _newMemberUsername = string.Empty;
        await LoadWorkspaceDataAsync();
        _statusMessage = "Added group member.";
    }

    /// <summary>
    /// Removes an explicit member from a permission group.
    /// </summary>
    /// <param name="groupId">The group identifier.</param>
    /// <param name="platformId">The platform identifier.</param>
    /// <param name="platformUserId">The platform user identifier.</param>
    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
    private async Task RemoveMemberAsync(Guid groupId, string platformId, string platformUserId)
    {
        if (_workspaceId is not Guid workspaceId)
        {
            return;
        }

        await PermissionStore.RemoveGroupMemberAsync(groupId, platformId, platformUserId);
        await PermissionService.InvalidateWorkspaceAsync(workspaceId);
        await LoadWorkspaceDataAsync();
        _statusMessage = "Removed group member.";
    }

    /// <summary>
    /// Loads workspace details, permission groups, grants, and group members from <see cref="IPermissionStore"/>.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
    private async Task LoadWorkspaceDataAsync()
    {
        if (_workspaceId is not Guid workspaceId)
        {
            return;
        }

        _categories = PermissionRegistry.GetCategories();
        _allDescriptors = PermissionRegistry.GetAll();
        _workspace = await PermissionStore.GetWorkspaceAsync(workspaceId);
        _groups = await PermissionStore.GetGroupsAsync(workspaceId);

        _grantStates.Clear();
        _groupMembers.Clear();

        foreach (PermissionGroup group in _groups)
        {
            IReadOnlyList<PermissionGrant> grants = await PermissionStore.GetGrantsAsync(group.Id);
            foreach (PermissionGrant grant in grants)
            {
                _grantStates[(group.Id, grant.PermissionKey)] = grant.State;
            }

            IReadOnlyList<PermissionGroupMember> members = await PermissionStore.GetGroupMembersAsync(group.Id);
            _groupMembers[group.Id] = members;
        }

        if (_selectedGroup is not null)
        {
            PermissionGroup? refreshed = _groups.FirstOrDefault(g => g.Id == _selectedGroup.Id);
            if (refreshed is null)
            {
                _selectedGroup = null;
                if (_currentMode != PermissionsPageMode.List && !_isAuditView)
                {
                    _currentMode = PermissionsPageMode.List;
                }
            }
            else
            {
                _selectedGroup = refreshed;
                if (_currentMode == PermissionsPageMode.Edit && !HasUnsavedChanges)
                {
                    InitializeEditBuffer(refreshed.Id);
                }
            }
        }
    }

    /// <summary>
    /// Handles <see cref="PermissionsInvalidatedEvent"/> notifications from the event bus.
    /// </summary>
    /// <param name="evt">The invalidation event.</param>
    /// <param name="cancellationToken">A token to monitor for cancellation requests.</param>
    /// <returns>A <see cref="ValueTask"/> representing the asynchronous operation.</returns>
    private ValueTask OnPermissionsInvalidatedAsync(PermissionsInvalidatedEvent evt, CancellationToken cancellationToken)
    {
        if (_workspaceId is not Guid currentWorkspaceId)
        {
            return ValueTask.CompletedTask;
        }

        if (evt.WorkspaceId is not null && evt.WorkspaceId != currentWorkspaceId)
        {
            return ValueTask.CompletedTask;
        }

        return new ValueTask(InvokeAsync(async () =>
        {
            await LoadWorkspaceDataAsync();
            StateHasChanged();
        }));
    }
}
