    /// </summary>
    private string _newMemberPlatformId = "twitch";

    /// <summary>
    /// Platform user identifier for adding a new group member.
    /// </summary>
    private string _newMemberPlatformUserId = string.Empty;

    /// <summary>
    /// Optional username for adding a new group member.
