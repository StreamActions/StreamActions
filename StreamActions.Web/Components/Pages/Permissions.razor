@page "/permissions"
@attribute [Authorize(Policy = AuthClaims.PanelAuthenticatedPolicy)]
@rendermode InteractiveServer
@implements IDisposable

@using System.Security.Claims
@using Microsoft.Extensions.DependencyInjection
@using StreamActions.Core.Abstractions
@using StreamActions.Core.Models
@using StreamActions.Core.Models.Entities
@using StreamActions.Core.Permissions

@inject IPermissionStore PermissionStore
@inject IPermissionService PermissionService
@inject IPermissionRegistry PermissionRegistry
@inject IEventBus EventBus
@inject IWorkspaceSessionContext WorkspaceSession
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation

<PageTitle>@AuthPolicyParser.FormatPageTitle("Workspace Permissions", _instanceName)</PageTitle>

<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges"
                OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />

<h1>Workspace Permissions</h1>

<section aria-labelledby="workspace-selector-heading">
    <h2 id="workspace-selector-heading">Workspace</h2>
    @if (_workspace is not null)
    {
        <p>Active workspace: <strong>@_workspace.Name</strong> (@_workspace.Id)</p>
    }
    else if (_workspaceId is not null)
    {
        <p>Workspace ID: <code>@_workspaceId</code></p>
    }
    else
    {
        <p>No accessible workspace is currently selected.</p>
    }

    @if (_workspaceId is not null && _currentMode == PermissionsPageMode.List)
    {
        <div>
            <button type="button" @onclick="SeedBuiltInGroupsAsync">Seed Built-in Groups</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <p role="status">@_statusMessage</p>
    }
</section>

<p data-permission-hierarchy-guide="true">
    <strong>Permission Hierarchy (Allow / Inherit / Explicit Deny):</strong>
    <strong>Explicit Deny</strong> always wins over <strong>Allow</strong> across all matching groups.
    <strong>Allow</strong> grants a permission when no Explicit Deny exists.
    <strong>Inherit</strong> defers to other groups and defaults to Deny if no group grants Allow.
    Tier 1 Global Groups govern <code>[Globally Gated]</code> features before Tier 2 Workspace Groups are evaluated.
</p>

@if (_workspaceId is not null)
{
    <div>
        <label for="permissions-search">Search Permissions, Groups &amp; Members:</label>
        <input id="permissions-search"
               data-permissions-search="true"
               type="search"
               @bind="_searchQuery"
               @bind:event="oninput"
               placeholder="Filter permissions, groups, or members..." />
    </div>

    <StepUpMfaGuard WorkspaceId="@_workspaceId"
                    OperationDescription="Confirm MFA verification to modify workspace permission groups, grants, or group members.">

        @if (_showUnsavedNavigationPrompt)
        {
            <div role="alertdialog"
                 aria-labelledby="unsaved-nav-prompt-heading"
                 data-unsaved-navigation-prompt="true">
                <h3 id="unsaved-nav-prompt-heading">Unsaved Permission Changes</h3>
                <p>You have @UnsavedChangesCount unsaved permission change(s) for <strong>@(_selectedGroup?.Name)</strong>. Do you want to discard your staged changes?</p>
                <button type="button"
                        data-confirm-discard-changes="true"
                        @onclick="ConfirmDiscardAndNavigateAsync">
                    Discard Changes &amp; Leave
                </button>
                <button type="button"
                        data-cancel-discard-changes="true"
                        @onclick="CancelDiscardNavigation">
                    Stay in Editor
                </button>
            </div>
        }

        @if (_currentMode == PermissionsPageMode.List)
        {
            <section aria-labelledby="custom-groups-heading" data-permissions-mode="List">
                <h2 id="custom-groups-heading">Permission Groups</h2>
                <div>
                    <label for="new-group-name">New Custom Group:</label>
                    <input id="new-group-name" type="text" @bind="_newGroupName" placeholder="Group name" />
                    <button type="button" data-create-group="true" @onclick="CreateCustomGroupAsync">Create Group</button>
                </div>

                <DataTableGrid TItem="PermissionGroup"
                               GridId="workspace-groups-grid"
                               Items="@_groups"
                               SearchQuery="@_searchQuery"
                               SearchQueryChanged="OnSearchQueryChanged"
                               FilterPredicate="MatchesGroupSearch"
                               SearchPlaceholder="Filter workspace groups...">
                    <EmptyContent>
                        <p>No permission groups found for this workspace. Seed built-in groups or create a custom group.</p>
                    </EmptyContent>
                    <HeaderContent>
                        <tr>
                            <th>Group Name</th>
                            <th>Type / Mapping</th>
                            <th>Explicit Members</th>
                            <th>Actions</th>
                        </tr>
                    </HeaderContent>
                    <RowTemplate Context="group">
                        <tr @key="group.Id" data-group-row="@group.Id">
                            <td><strong>@group.Name</strong></td>
                            <td>
                                @if (IsBuiltInGroup(group))
                                {
                                    <span data-group-badge="built-in">(Built-in: @(group.MappedPlatformDesignation ?? group.MappedOidcGroupClaim))</span>
                                }
                                else
                                {
                                    <span data-group-badge="custom">(Custom)</span>
                                }
                            </td>
                            <td>@GetMembersForGroup(group.Id).Count</td>
                            <td>
                                <button type="button"
                                        data-group-view="@group.Id"
                                        @onclick="() => EnterViewGroupMode(group)">
                                    View
                                </button>
                                <button type="button"
                                        data-group-edit="@group.Id"
                                        @onclick="() => EnterEditGroupMode(group)">
                                    Edit
                                </button>
                                @if (!IsBuiltInGroup(group))
                                {
                                    <button type="button"
                                            data-group-delete="@group.Id"
                                            @onclick="() => DeleteGroupAsync(group.Id)">
                                        Delete Group
                                    </button>
                                }
                            </td>
                        </tr>
                    </RowTemplate>
                </DataTableGrid>
            </section>

            <section aria-labelledby="user-audit-launch-heading" data-audit-launch-card="user">
                <h2 id="user-audit-launch-heading">Effective Permission Audit</h2>
                <p>Select or enter a user identity to inspect their resolved two-tier effective permissions and contributing groups.</p>
                <div>
                    @if (AllDistinctMembers.Count > 0)
                    {
                        <label for="audit-member-quick-pick">Quick-Pick Group Member:</label>
                        <select id="audit-member-quick-pick"
                                data-audit-member-quick-pick="true"
                                @onchange="OnQuickPickAuditMember">
                            <option value="">-- Custom user identity --</option>
                            @foreach (PermissionGroupMember member in AllDistinctMembers)
                            {
                                string key = $"{member.PlatformId}:{member.PlatformUserId}";
                                string label = string.IsNullOrWhiteSpace(member.LastKnownUsername)
                                    ? key
                                    : $"{member.LastKnownUsername} ({key})";
                                <option value="@key">@label</option>
                            }
                        </select>
                    }

                    <label for="audit-platform-id">Platform ID:</label>
                    <input id="audit-platform-id"
                           data-audit-platform-id="true"
                           type="text"
                           @bind="_auditPlatformId"
                           placeholder="twitch" />

                    <label for="audit-user-id">Platform User ID:</label>
                    <input id="audit-user-id"
                           data-audit-user-id="true"
                           type="text"
                           @bind="_auditPlatformUserId"
                           placeholder="User ID" />

                    <label for="audit-username">Username:</label>
                    <input id="audit-username"
                           data-audit-username="true"
                           type="text"
                           @bind="_auditUsername"
                           placeholder="Username" />

                    <fieldset>
                        <legend>Live Platform Designations:</legend>
                        <label>
                            <input type="checkbox"
                                   data-audit-designation="Broadcaster"
                                   checked="@_auditDesignations.HasFlag(PlatformUserDesignations.Broadcaster)"
                                   @onchange="(ChangeEventArgs e) => ToggleAuditDesignation(PlatformUserDesignations.Broadcaster, e)" />
                            Broadcaster
                        </label>
                        <label>
                            <input type="checkbox"
                                   data-audit-designation="Moderator"
                                   checked="@_auditDesignations.HasFlag(PlatformUserDesignations.Moderator)"
                                   @onchange="(ChangeEventArgs e) => ToggleAuditDesignation(PlatformUserDesignations.Moderator, e)" />
                            Moderator
                        </label>
                        <label>
                            <input type="checkbox"
                                   data-audit-designation="Vip"
                                   checked="@_auditDesignations.HasFlag(PlatformUserDesignations.Vip)"
                                   @onchange="(ChangeEventArgs e) => ToggleAuditDesignation(PlatformUserDesignations.Vip, e)" />
                            VIP
                        </label>
                        <label>
                            <input type="checkbox"
                                   data-audit-designation="Subscriber"
                                   checked="@_auditDesignations.HasFlag(PlatformUserDesignations.Subscriber)"
                                   @onchange="(ChangeEventArgs e) => ToggleAuditDesignation(PlatformUserDesignations.Subscriber, e)" />
                            Subscriber
                        </label>
                    </fieldset>

                    <button type="button"
                            data-launch-user-audit="true"
                            @onclick="LaunchUserAuditAsync">
                        Audit User Permissions
                    </button>
                </div>
            </section>
        }
        else if (_currentMode == PermissionsPageMode.View)
        {
            <section aria-labelledby="view-mode-heading" data-permissions-mode="View">
                <div class="sa-permissions-mode-header">
                    @if (_isAuditView)
                    {
                        <h2 id="view-mode-heading">Permission Audit: @_auditTargetLabel</h2>
                    }
                    else if (_selectedGroup is not null)
                    {
                        <h2 id="view-mode-heading">Viewing Group: @_selectedGroup.Name</h2>
                    }

                    <div>
                        <button type="button"
                                data-back-to-groups="true"
                                @onclick="RequestBackToGroups">
                            Back to Groups
                        </button>
                        @if (!_isAuditView && _selectedGroup is not null)
                        {
                            <button type="button"
                                    data-enter-edit-mode="true"
                                    @onclick="() => EnterEditGroupMode(_selectedGroup)">
                                Edit Permissions
                            </button>
                        }
                    </div>
                </div>

                @if (_isAuditView)
                {
                    <DataTableGrid TItem="PermissionAuditBreakdown"
                                   GridId="user-audit-grid"
                                   Items="@FilteredAuditBreakdowns"
                                   TotalUnfilteredCount="@_auditBreakdowns.Count"
                                   SearchQuery="@_searchQuery"
                                   SearchQueryChanged="OnSearchQueryChanged"
                                   FilterPredicate="MatchesAuditSearch"
                                   SearchPlaceholder="Filter audited permissions...">
                        <FilterContent>
                            <label for="audit-category-filter">Category:</label>
                            <select id="audit-category-filter"
                                    data-category-filter="true"
                                    @bind="_selectedCategoryFilter">
                                <option value="">All Categories</option>
                                @foreach (string category in _categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </FilterContent>
                        <HeaderContent>
                            <tr>
                                <th>Permission</th>
                                <th>Category</th>
                                <th>Effective Outcome</th>
                                <th>Determined By</th>
                                <th>Breakdown</th>
                            </tr>
                        </HeaderContent>
                        <RowTemplate Context="item">
                            <tr @key="item.Descriptor.Key" data-audit-row="@item.Descriptor.Key">
                                <td>
                                    <strong>@item.Descriptor.DisplayName</strong>
                                    <code>(@item.Descriptor.Key)</code>
                                    @if (item.Descriptor.IsGloballyGated)
                                    {
                                        <span>[Globally Gated]</span>
                                    }
                                    <div>@item.Descriptor.Description</div>
                                </td>
                                <td>@item.Descriptor.Category</td>
                                <td>
                                    <span data-audit-outcome="@(item.IsAllowed ? "Allowed" : "Denied")">
                                        @(item.IsAllowed ? "Allowed" : "Denied")
                                    </span>
                                </td>
                                <td data-audit-determined-by="@item.Descriptor.Key">
                                    @item.DeterminedByDisplay
                                </td>
                                <td>
                                    <div>@item.SummaryReason</div>
                                    <details data-audit-breakdown="@item.Descriptor.Key">
                                        <summary>View Contributions (@item.Contributions.Count)</summary>
                                        <ul>
                                            @foreach (PermissionContribution contribution in item.Contributions)
                                            {
                                                <li data-audit-contribution="@contribution.SourceName">
                                                    <strong>@contribution.SourceName</strong>:
                                                    <span>@contribution.DisplayState</span>
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                </td>
                            </tr>
                        </RowTemplate>
                    </DataTableGrid>
                }
                else if (_selectedGroup is not null)
                {
                    <DataTableGrid TItem="PermissionDescriptor"
                                   GridId="view-group-permissions-grid"
                                   Items="@FilteredDescriptorsByCategory"
                                   TotalUnfilteredCount="@_allDescriptors.Count"
                                   SearchQuery="@_searchQuery"
                                   SearchQueryChanged="OnSearchQueryChanged"
                                   FilterPredicate="MatchesDescriptorSearch"
                                   SearchPlaceholder="Filter permissions...">
                        <FilterContent>
                            <label for="view-category-filter">Category:</label>
                            <select id="view-category-filter"
                                    data-category-filter="true"
                                    @bind="_selectedCategoryFilter">
                                <option value="">All Categories</option>
                                @foreach (string category in _categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </FilterContent>
                        <HeaderContent>
                            <tr>
                                <th>Permission</th>
                                <th>Category</th>
                                <th>State for @_selectedGroup.Name</th>
                            </tr>
                        </HeaderContent>
                        <RowTemplate Context="descriptor">
                            <tr @key="descriptor.Key" data-permission-row="@descriptor.Key">
                                <td>
                                    <strong>@descriptor.DisplayName</strong>
                                    <code>(@descriptor.Key)</code>
                                    @if (descriptor.IsGloballyGated)
                                    {
                                        <span>[Globally Gated]</span>
                                    }
                                    @if (descriptor.IsDangerousGlobalFeature)
                                    {
                                        <span>[Dangerous]</span>
                                    }
                                    <div>@descriptor.Description</div>
                                </td>
                                <td>@descriptor.Category</td>
                                <td data-permission-state="@descriptor.Key">
                                    <strong>@GetSavedGrantState(_selectedGroup.Id, descriptor.Key)</strong>
                                </td>
                            </tr>
                        </RowTemplate>
                    </DataTableGrid>

                    <section aria-labelledby="group-members-heading">
                        <h3 id="group-members-heading">@_selectedGroup.Name Members</h3>
                        <div>
                            <label for="member-platform-input">Platform ID:</label>
                            <input id="member-platform-input" type="text" @bind="_newMemberPlatformId" placeholder="twitch" />
                            <label for="member-userid-input">Platform User ID:</label>
                            <input id="member-userid-input" type="text" @bind="_newMemberPlatformUserId" placeholder="User ID" />
                            <label for="member-username-input">Username:</label>
                            <input id="member-username-input" type="text" @bind="_newMemberUsername" placeholder="Optional username" />
                            <button type="button" data-add-member="true" @onclick="AddMemberToSelectedGroupAsync">Add Member</button>
                        </div>

                        <DataTableGrid TItem="PermissionGroupMember"
                                       GridId="view-group-members-grid"
                                       Items="@GetMembersForGroup(_selectedGroup.Id)"
                                       SearchQuery="@_searchQuery"
                                       SearchQueryChanged="OnSearchQueryChanged"
                                       FilterPredicate="MatchesMemberSearch"
                                       SearchPlaceholder="Filter group members...">
                            <EmptyContent>
                                <p>No explicit members assigned to @_selectedGroup.Name.</p>
                            </EmptyContent>
                            <HeaderContent>
                                <tr>
                                    <th>Platform Identity</th>
                                    <th>Username</th>
                                    <th>Actions</th>
                                </tr>
                            </HeaderContent>
                            <RowTemplate Context="member">
                                <tr @key="@($"{member.PlatformId}:{member.PlatformUserId}")">
                                    <td><span>@member.PlatformId:@member.PlatformUserId</span></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(member.LastKnownUsername))
                                        {
                                            <span>(@member.LastKnownUsername)</span>
                                        }
                                    </td>
                                    <td>
                                        <button type="button"
                                                data-remove-member="@($"{member.PlatformId}:{member.PlatformUserId}")"
                                                @onclick="() => RemoveMemberAsync(_selectedGroup.Id, member.PlatformId, member.PlatformUserId)">
                                            Remove
                                        </button>
                                    </td>
                                </tr>
                            </RowTemplate>
                        </DataTableGrid>
                    </section>
                }
            </section>
        }
        else if (_currentMode == PermissionsPageMode.Edit && _selectedGroup is not null)
        {
            <section aria-labelledby="edit-mode-heading" data-permissions-mode="Edit">
                <div class="sa-permissions-mode-header">
                    <h2 id="edit-mode-heading">Editing Group: @_selectedGroup.Name</h2>
                    <div>
                        <button type="button"
                                data-back-to-groups="true"
                                @onclick="RequestBackToGroups">
                            Back to Groups
                        </button>
                        <button type="button"
                                data-switch-to-view-mode="true"
                                @onclick="RequestSwitchToViewMode">
                            View Mode
                        </button>
                    </div>
                </div>

                @if (IsSelfEscalationWarningActive)
                {
                    <div role="alert"
                         data-self-escalation-warning="true"
                         class="sa-self-escalation-warning">
                        <p>
                            <strong>Self-Escalation Warning:</strong>
                            Granting <strong>Manage Permissions (<code>@BuiltInPermissionKeys.UiPermissionsManage</code>)</strong>
                            to group <strong>@_selectedGroup.Name</strong> will allow members of this group to access the Workspace Permissions page and modify their own permissions.
                        </p>
                        @if (!_selfEscalationConfirmed)
                        {
                            <div>
                                <button type="button"
                                        data-confirm-self-escalation="true"
                                        @onclick="ConfirmSelfEscalation">
                                    Confirm Self-Escalation
                                </button>
                                <button type="button"
                                        data-cancel-self-escalation="true"
                                        @onclick="CancelSelfEscalation">
                                    Cancel
                                </button>
                            </div>
                        }
                        else
                        {
                            <p data-self-escalation-confirmed="true"><em>Self-escalation confirmed for this save operation.</em></p>
                        }
                    </div>
                }

                <div class="sa-bulk-page-toolbar" data-bulk-page-toolbar="true">
                    <strong>Set All Permissions for @_selectedGroup.Name to:</strong>
                    <button type="button"
                            data-bulk-page-allow="true"
                            @onclick="() => SetAllPermissionsForActiveGroup(PermissionState.Allow)">
                        Allow
                    </button>
                    <button type="button"
                            data-bulk-page-inherit="true"
                            @onclick="() => SetAllPermissionsForActiveGroup(PermissionState.Inherit)">
                        Inherit
                    </button>
                    <button type="button"
                            data-bulk-page-deny="true"
                            @onclick="() => SetAllPermissionsForActiveGroup(PermissionState.Deny)">
                        Deny
                    </button>
                </div>

                <div class="sa-bulk-categories-toolbar" data-bulk-categories-toolbar="true">
                    @foreach (string category in _categories)
                    {
                        string currentCategory = category;
                        <div class="sa-bulk-category-group" data-bulk-category-group="@currentCategory">
                            <span><strong>@currentCategory:</strong></span>
                            <button type="button"
                                    data-bulk-category-allow="@currentCategory"
                                    @onclick="() => SetCategoryPermissionsForActiveGroup(currentCategory, PermissionState.Allow)">
                                Allow
                            </button>
                            <button type="button"
                                    data-bulk-category-inherit="@currentCategory"
                                    @onclick="() => SetCategoryPermissionsForActiveGroup(currentCategory, PermissionState.Inherit)">
                                Inherit
                            </button>
                            <button type="button"
                                    data-bulk-category-deny="@currentCategory"
                                    @onclick="() => SetCategoryPermissionsForActiveGroup(currentCategory, PermissionState.Deny)">
                                Deny
                            </button>
                        </div>
                    }
                </div>

                <DataTableGrid TItem="PermissionDescriptor"
                               GridId="edit-group-permissions-grid"
                               Items="@FilteredDescriptorsByCategory"
                               TotalUnfilteredCount="@_allDescriptors.Count"
                               SearchQuery="@_searchQuery"
                               SearchQueryChanged="OnSearchQueryChanged"
                               FilterPredicate="MatchesDescriptorSearch"
                               SearchPlaceholder="Filter permissions...">
                    <FilterContent>
                        <label for="edit-category-filter">Category:</label>
                        <select id="edit-category-filter"
                                data-category-filter="true"
                                @bind="_selectedCategoryFilter">
                            <option value="">All Categories</option>
                            @foreach (string category in _categories)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                    </FilterContent>
                    <HeaderContent>
                        <tr>
                            <th>Permission</th>
                            <th>Category</th>
                            <th>@_selectedGroup.Name</th>
                        </tr>
                    </HeaderContent>
                    <RowTemplate Context="descriptor">
                        @{
                            PermissionState pendingState = GetPendingGrantState(descriptor.Key);
                            PermissionState savedState = GetSavedGrantState(_selectedGroup.Id, descriptor.Key);
                            bool isModified = pendingState != savedState;
                        }
                        <tr @key="descriptor.Key"
                            data-permission-row="@descriptor.Key"
                            data-permission-modified="@(isModified ? "true" : "false")">
                            <td>
                                <strong>@descriptor.DisplayName</strong>
                                <code>(@descriptor.Key)</code>
                                @if (descriptor.IsGloballyGated)
                                {
                                    <span>[Globally Gated]</span>
                                }
                                @if (descriptor.IsDangerousGlobalFeature)
                                {
                                    <span>[Dangerous]</span>
                                }
                                <div>@descriptor.Description</div>
                            </td>
                            <td>@descriptor.Category</td>
                            <td>
                                <select aria-label="@($"{descriptor.DisplayName} for {_selectedGroup.Name}")"
                                        data-permission-select="@descriptor.Key"
                                        @onchange="(ChangeEventArgs args) => OnPendingGrantChanged(descriptor.Key, args)">
                                    <option value="@PermissionState.Inherit" selected="@(pendingState == PermissionState.Inherit)">Inherit</option>
                                    <option value="@PermissionState.Allow" selected="@(pendingState == PermissionState.Allow)">Allow</option>
                                    <option value="@PermissionState.Deny" selected="@(pendingState == PermissionState.Deny)">Deny</option>
                                </select>
                            </td>
                        </tr>
                    </RowTemplate>
                </DataTableGrid>

                <div class="sa-sticky-save-bar"
                     data-sticky-save-bar="true"
                     style="position: sticky; bottom: 0;">
                    <span data-unsaved-changes-count="@UnsavedChangesCount">
                        @UnsavedChangesCount unsaved change(s) for @_selectedGroup.Name
                    </span>
                    <button type="button"
                            data-save-permissions="true"
                            disabled="@(!HasUnsavedChanges || (IsSelfEscalationWarningActive && !_selfEscalationConfirmed))"
                            @onclick="SavePendingChangesAsync">
                        Save Changes
                    </button>
                    <button type="button"
                            data-revert-permissions="true"
                            disabled="@(!HasUnsavedChanges)"
                            @onclick="RevertPendingChanges">
                        Revert
                    </button>
                </div>
            </section>
        }
    </StepUpMfaGuard>
}

@code {
    /// <summary>
    /// Cached persisted permission grant states keyed by group and permission key.
    /// </summary>
    private readonly Dictionary<(Guid GroupId, string PermissionKey), PermissionState> _grantStates = [];

    /// <summary>
    /// Snapshot of the selected group's persisted grant states when entering <see cref="PermissionsPageMode.Edit"/>.
    /// </summary>
    private readonly Dictionary<string, PermissionState> _savedGrantStates = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// In-memory staged grant states for the selected group in <see cref="PermissionsPageMode.Edit"/>.
    /// </summary>
    private readonly Dictionary<string, PermissionState> _pendingGrantStates = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Cached group member lists keyed by group identifier.
    /// </summary>
    private readonly Dictionary<Guid, IReadOnlyList<PermissionGroupMember>> _groupMembers = [];

    /// <summary>
    /// Cascading authentication state task used to determine whether the viewing operator is Root or Global Admin.
    /// </summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// Active workspace identifier from <see cref="IWorkspaceSessionContext"/>.
    /// </summary>
    private Guid? _workspaceId;

    /// <summary>
    /// Loaded active workspace entity.
    /// </summary>
    private Workspace? _workspace;

    /// <summary>
    /// Permission groups belonging to the active workspace.
    /// </summary>
    private IReadOnlyList<PermissionGroup> _groups = [];

    /// <summary>
    /// All registered permission descriptors.
    /// </summary>
    private IReadOnlyList<PermissionDescriptor> _allDescriptors = [];

    /// <summary>
    /// Registered permission categories.
    /// </summary>
    private IReadOnlyList<string> _categories = [];

    /// <summary>
    /// Current page mode (<see cref="PermissionsPageMode.List"/>, <see cref="PermissionsPageMode.View"/>, or <see cref="PermissionsPageMode.Edit"/>).
    /// </summary>
    private PermissionsPageMode _currentMode = PermissionsPageMode.List;

