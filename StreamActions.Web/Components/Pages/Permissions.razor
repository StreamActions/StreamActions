    private string _newMemberUsername = string.Empty;

    /// <summary>
    /// Prior state of <see cref="BuiltInPermissionKeys.UiPermissionsManage"/> before a staged change set it to <see cref="PermissionState.Allow"/>.
    /// </summary>
    private PermissionState _priorUiPermissionsManageState = PermissionState.Inherit;

    /// <summary>
    /// Whether the operator has explicitly confirmed the <c>ui.permissions.manage</c> self-escalation warning in the current edit session.
    /// </summary>
    private bool _selfEscalationConfirmed;

