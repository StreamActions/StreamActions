@inherits LayoutComponentBase
@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using StreamActions.Core.Abstractions
@using StreamActions.Core.Models
@using StreamActions.Core.Models.Entities

@inject IWorkspaceSessionContext WorkspaceSession
@inject IInstanceSettingsService InstanceSettingsService
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider

<div class="page">
    <header class="top-nav px-4">
        <a class="navbar-brand" href="/" data-instance-name="true">@_instanceName</a>
        <nav aria-label="Main navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/workspace/platforms">Platforms</NavLink>
            <NavLink href="/permissions">Permissions</NavLink>
            <NavLink href="/admin/global-permissions">Global Permissions</NavLink>
            <AuthorizeView Policy="@AuthClaims.RootOrGlobalAdminPolicy">
                <Authorized>
                    <NavLink href="/admin/auth">Auth Settings</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@AuthClaims.PanelAuthenticatedPolicy">
                <Authorized>
                    <NavLink href="/account/mfa">Security &amp; MFA</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>
        <div class="auth-status">
            <AuthorizeView Policy="@AuthClaims.PanelAuthenticatedPolicy">
                <Authorized>
                    @if (WorkspaceSession.AccessibleWorkspaces.Count > 0)
                    {
                        <form method="post" action="/auth/workspace/select" data-workspace-switcher="true">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="@GetCurrentLocalPath()" />
                            <label for="workspace-switcher-select">Workspace:</label>
                            <select id="workspace-switcher-select" name="workspaceId" onchange="this.form.submit()">
                                @foreach (AccessibleWorkspace ws in WorkspaceSession.AccessibleWorkspaces)
                                {
                                    bool requiresReauth = ws.AuthStatus != WorkspaceSessionAuthStatus.Ready;
                                    string optionLabel = requiresReauth
                                        ? $"{ws.Workspace.Name} ({ws.Workspace.PrimaryPlatformId}) (reauthenticate)"
                                        : $"{ws.Workspace.Name} ({ws.Workspace.PrimaryPlatformId})";
                                    <option value="@ws.Workspace.Id.ToString("D")"
                                            selected="@(ws.Workspace.Id == WorkspaceSession.ActiveWorkspaceId)"
                                            class="@(requiresReauth ? "workspace-option-reauth" : null)"
                                            style="@(requiresReauth ? "color: #6c757d;" : null)"
                                            data-workspace-auth-status="@ws.AuthStatus">
                                        @optionLabel
                                    </option>
                                }
                            </select>
                            <button type="submit">Switch</button>
                        </form>
                    }
                    <span class="user-display-name">@context.User.Identity?.Name</span>
                    <form method="post" action="/auth/logout">
                        <AntiforgeryToken />
                        <button type="submit">Sign Out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/login">Sign In</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>
    <main>
        <article class="content px-4">
            @if (_showMfaAdminResetNotice)
            {
                <div role="alert" data-mfa-admin-reset-notice="true">
                    Your multi-factor authentication credentials were removed by an instance administrator.
                    <a href="/account/mfa">Manage MFA</a>
                </div>
            }
            @Body
        </article>
    </main>
</div>

@code {
    /// <summary>
    /// Display name rendered in the top navigation bar brand.
    /// </summary>
    private string _instanceName = AuthPolicyParser.DefaultInstanceName;

    /// <summary>
    /// Indicates whether an administrator removed the current user's MFA credentials and a notice banner should be shown.
    /// </summary>
    private bool _showMfaAdminResetNotice;

    /// <summary>
    /// Active subscription handle for <see cref="UserSessionsRevokedEvent"/> notifications on <see cref="IEventBus"/>.
    /// </summary>
    private IDisposable? _sessionRevocationSubscription;

    /// <summary>
    /// Initializes the workspace session context and instance branding for the layout.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous initialization operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        WorkspaceSession.WorkspaceChanged += OnWorkspaceChanged;
        InstanceSettingsService.SettingsChanged += OnSettingsChanged;

        IEventBus? eventBus = ServiceProvider.GetService<IEventBus>();
        if (eventBus is not null)
        {
            _sessionRevocationSubscription = eventBus.Subscribe<UserSessionsRevokedEvent>(HandleUserSessionsRevokedAsync);
        }

        InstanceSettings settings = await InstanceSettingsService.GetAsync().ConfigureAwait(false);
        _instanceName = AuthPolicyParser.ResolveInstanceName(settings);

        AuthenticationStateProvider? authStateProvider = ServiceProvider.GetService<AuthenticationStateProvider>();
        IPanelUserStore? panelUserStore = ServiceProvider.GetService<IPanelUserStore>();
        if (authStateProvider is not null && panelUserStore is not null)
        {
            AuthenticationState authState = await authStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
            Guid? panelUserId = AuthClaims.GetPanelUserId(authState.User);
            if (panelUserId.HasValue)
            {
                PanelUser? user = await panelUserStore.GetByIdAsync(panelUserId.Value).ConfigureAwait(false);
                _showMfaAdminResetNotice = user?.MfaResetByAdminNoticePending == true;
            }
        }

        await WorkspaceSession.InitializeAsync().ConfigureAwait(false);
    }

    /// <summary>
    /// Releases layout event subscriptions.
    /// </summary>
    public void Dispose()
    {
        WorkspaceSession.WorkspaceChanged -= OnWorkspaceChanged;
        InstanceSettingsService.SettingsChanged -= OnSettingsChanged;
        _sessionRevocationSubscription?.Dispose();
        _sessionRevocationSubscription = null;
    }

    /// <summary>
    /// Redirects the active Blazor circuit to <c>/login?error=session_revoked</c> when the current user's session is revoked.
    /// </summary>
    /// <param name="evt">The session revocation event payload.</param>
    /// <param name="cancellationToken">A token to monitor for cancellation requests.</param>
    /// <returns>A <see cref="ValueTask"/> representing the asynchronous handler execution.</returns>
    private async ValueTask HandleUserSessionsRevokedAsync(
        UserSessionsRevokedEvent evt,
        CancellationToken cancellationToken)
    {
        AuthenticationStateProvider? authStateProvider = ServiceProvider.GetService<AuthenticationStateProvider>();
        if (authStateProvider is null)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            AuthenticationState authState = await authStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
            ClaimsPrincipal user = authState.User;
            if (AuthClaims.GetPanelUserId(user) == evt.PanelUserId
                && (evt.ExcludedSessionId is null || AuthClaims.GetSessionId(user) != evt.ExcludedSessionId))
            {
                Navigation.NavigateTo("/login?error=session_revoked", forceLoad: true);
            }
        }).ConfigureAwait(false);
    }

    /// <summary>
    /// Updates the layout brand when instance settings change.
    /// </summary>
    /// <param name="sender">The event sender.</param>
    /// <param name="args">The event arguments containing updated settings.</param>
    private void OnSettingsChanged(object? sender, InstanceSettingsChangedEventArgs args)
    {
        _instanceName = AuthPolicyParser.ResolveInstanceName(args.Settings);
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Re-renders the layout when the active workspace selection changes.
    /// </summary>
    /// <param name="sender">The event sender.</param>
    /// <param name="args">The event arguments.</param>
    private void OnWorkspaceChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Returns the current relative local path for safe workspace-switch redirects.
    /// </summary>
    /// <returns>A safe relative local URL starting with <c>/</c>.</returns>
    private string GetCurrentLocalPath()
    {
        string relative = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        return AuthClaims.SafeReturnUrlOrDefault(relative, "/");
    }
}
